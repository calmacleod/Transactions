class NativePagination
  attr_reader count: Integer
  attr_reader page: Integer
  attr_reader pages: Integer
  attr_reader from: Integer
  attr_reader to: Integer
  attr_reader offset: Integer
  def initialize: (Integer count, Integer page, Integer limit) -> void
end
module NativeViewHelpers
  def self.number_with_delimiter: (untyped value) -> String
  def self.number_to_currency: (untyped value, ?precision: Integer) -> String
  def self.pluralize: (Integer count, String singular, ?String? plural) -> String
end
module ActionController
  class Base
    def pagy: (Symbol method, ActiveRecord::Relation relation, limit: Integer) -> [NativePagination, Array[untyped]]
  end
end
class User
  def password_reset_token: () -> String
  def self.find_by_password_reset_token!: (String token) -> User
end
