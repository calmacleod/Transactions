new file mode 100644
index 00000000..aa800b74
--- /dev/null
+++ b/tests/contextual_helper_keywords.rs
@@ -0,0 +1,142 @@
+//! Contextual optional keyword defaults remain evaluated by the callee.
+//! This is independent of native full-forwarding support and does not
+//! change the retained source provenance used by its admission gates.
+
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+#[test]
+fn constructor_instance_and_class_defaults_keep_the_callee_context() {
+    let source = r#"class ContextualKeywordProbe
+  def initialize(default: label, extra: "default")
+    @value = default + ":" + extra
+  end
+
+  def label
+    "callee"
+  end
+
+  def value
+    @value
+  end
+
+  def call(default: label, extra: "default")
+    default + ":" + extra
+  end
+
+  def self.label
+    "class"
+  end
+
+  def self.class_call(default: label, extra: "default")
+    default + ":" + extra
+  end
+
+  def self.run
+    ContextualKeywordProbe.new(extra: "constructor").value + "|" +
+      ContextualKeywordProbe.new.call(extra: "instance") + "|" +
+      class_call(extra: "bare") + "|" +
+      ContextualKeywordProbe.class_call(extra: "explicit")
+  end
+end
+"#;
+    let run = emit_and_run::real_blog()
+        .write("app/lib/contextual_keyword_probe.rb", source)
+        .run_ruby(r#"
+expected = "callee:constructor|callee:instance|class:bare|class:explicit"
+raise "contextual keyword binding: #{ContextualKeywordProbe.run.inspect}" unless ContextualKeywordProbe.run == expected
+raise "explicit first keyword ignored" unless ContextualKeywordProbe.new(default: "given", extra: "explicit").value == "given:explicit"
+puts "contextual defaults: constructor, instance, bare class, explicit class passed"
+"#);
+    run.assert_passes();
+    let emitted =
+        std::fs::read_to_string(run.emitted.join("app/models/contextual_keyword_probe.rb"))
+            .unwrap();
+    assert!(emitted.contains("def initialize(default:"), "{emitted}");
+    assert!(emitted.contains("def call(default:"), "{emitted}");
+    assert!(
+        emitted.contains("def self.class_call(default:"),
+        "{emitted}"
+    );
+}
+
+#[test]
+fn an_instance_keyword_with_an_earlier_parameter_default_runs_both_call_shapes() {
+    let source = r##"class ContextualFetcher
+  def fetch(url, ip: url.upcase)
+    "#{url}@#{ip}"
+  end
+
+  def merge(url, opts = {})
+    "#{url}#{opts}"
+  end
+end
+
+class ContextualLocator
+  def self.explicit(url)
+    ContextualFetcher.new.fetch(url, ip: "192.0.2.1")
+  end
+
+  def self.omitted(url)
+    ContextualFetcher.new.fetch(url)
+  end
+
+  def self.merged(url)
+    ContextualFetcher.new.merge(url, opts: 1)
+  end
+
+  def self.run
+    explicit("example") + "|" + omitted("example") + "|" + merged("example")
+  end
+end
+"##;
+    let run = emit_and_run::real_blog()
+        .write("app/lib/contextual_fetcher.rb", source)
+        .run_ruby(r#"
+expected = "example@192.0.2.1|example@EXAMPLE|example#{ {opts: 1} }"
+actual = ContextualLocator.run
+raise "instance keyword/default/positional Hash binding: #{actual.inspect}" unless actual == expected
+puts "instance keyword: explicit, earlier-parameter default, positional Hash passed"
+"#);
+    run.assert_passes();
+    let fetcher =
+        std::fs::read_to_string(run.emitted.join("app/models/contextual_fetcher.rb")).unwrap();
+    let locator =
+        std::fs::read_to_string(run.emitted.join("app/models/contextual_locator.rb")).unwrap();
+    assert!(fetcher.contains("def fetch(url, ip:"), "{fetcher}");
+    assert!(
+        locator.contains(r#"ContextualFetcher.new.fetch(url, ip: "192.0.2.1")"#),
+        "{locator}"
+    );
+    assert!(
+        locator.contains("ContextualFetcher.new.merge(url, opts: 1)"),
+        "{locator}"
+    );
+}
+
+#[test]
+fn retaining_contextual_keywords_does_not_erase_forwarding_source_provenance() {
+    let source =
+        b"class Probe; def self.default; 7; end; def self.target(value: default); value; end; end";
+    let mut app = roundhouse::App::new();
+    app.library_classes
+        .extend(roundhouse::ingest::ingest_library_classes(source, "app/lib/probe.rb").unwrap());
+    roundhouse::session::analyze_and_lower(&mut app);
+    let method = app
+        .library_classes
+        .iter()
+        .find(|c| c.name.0.as_str() == "Probe")
+        .unwrap()
+        .methods
+        .iter()
+        .find(|m| m.name.as_str() == "target")
+        .unwrap();
+    assert!(
+        method.params[0].keyword,
+        "callee must retain native keyword binding"
+    );
+    assert!(
+        method.params[0].from_keyword,
+        "flattened-source provenance remains visible to forwarding admission"
+    );
+}
diff --git a/tests/data_factory_constants.rs b/tests/data_factory_constants.rs
new file mode 100644
index 00000000..6a7df9c4
--- /dev/null
+++ b/tests/data_factory_constants.rs
@@ -0,0 +1,179 @@
+//! Data.define assigns a real class to a constant; its aliases use the same
+//! declaration-based value inference as ordinary constants.
+
+use std::collections::HashMap;
+use std::path::PathBuf;
+
+use roundhouse::analyze::Analyzer;
+use roundhouse::ident::{ClassId, Symbol};
+use roundhouse::ty::Ty;
+
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+const DECLARATIONS: &str = r#"module Classification
+  class Preview
+    PreviewClassificationResult = Data.define(:category_name, :confidence, :included)
+    Result = PreviewClassificationResult
+    Alias = Result
+
+    def self.build
+      Result.new(category_name: "preview", confidence: 0.8, included: false)
+    end
+
+    def self.aliased
+      Alias.new(category_name: nil, confidence: 0.0, included: true)
+    end
+
+    def self.qualified
+      Classification::Preview::PreviewClassificationResult.new("qualified", 1.0, false)
+    end
+  end
+
+  class Merchant
+    Result = Data.define(:category_name)
+
+    def self.build
+      Result.new(category_name: "merchant")
+    end
+  end
+end
+"#;
+
+fn ingest(source: &str) -> roundhouse::App {
+    ingest_with_controller(
+        source,
+        "Classification::Preview::PreviewClassificationResult.new(\"checked\", 1.0, false)",
+    )
+}
+
+fn ingest_with_controller(source: &str, action: &str) -> roundhouse::App {
+    let tree: HashMap<PathBuf, Vec<u8>> = [(
+        PathBuf::from("app/services/classification.rb"),
+        source.as_bytes().to_vec(),
+    ), (
+        PathBuf::from("app/controllers/data_probe_controller.rb"),
+        format!("class DataProbeController < ApplicationController\n  def index\n    @result = {action}\n  end\nend\n").into_bytes(),
+    )]
+    .into_iter()
+    .collect();
+    roundhouse::ingest::ingest_app_from_tree(tree).expect("ingest")
+}
+
+#[test]
+fn literal_data_declarations_register_exact_members_without_writers() {
+    let app = ingest(DECLARATIONS);
+    let analyzer = Analyzer::new(&app);
+    let classes = analyzer.class_registry();
+    for (name, members) in [
+        (
+            "Classification::Preview::PreviewClassificationResult",
+            vec!["category_name", "confidence", "included"],
+        ),
+        ("Classification::Merchant::Result", vec!["category_name"]),
+    ] {
+        let id = ClassId(Symbol::from(name));
+        let class = &classes[&id];
+        assert_eq!(
+            class.class_methods.get(&Symbol::from("new")),
+            Some(&Ty::Class { id, args: vec![] })
+        );
+        for member in members {
+            assert_eq!(
+                class.instance_methods.get(&Symbol::from(member)),
+                Some(&Ty::Untyped)
+            );
+            assert!(!class
+                .instance_methods
+                .contains_key(&Symbol::from(format!("{member}="))));
+        }
+    }
+    assert!(!classes.contains_key(&ClassId(Symbol::from("Result"))));
+    assert!(
+        !classes.contains_key(&ClassId(Symbol::from("Classification::Preview::Result"))),
+        "an alias has its target value, not a fabricated second class"
+    );
+}
+
+#[test]
+fn declared_data_constructors_and_aliases_check_cleanly_and_execute() {
+    let run = emit_and_run::real_blog()
+        .write("app/lib/classification.rb", DECLARATIONS)
+        .write("app/controllers/data_probe_controller.rb", r#"class DataProbeController < ApplicationController
+  def index
+    @declared = Classification::Preview::PreviewClassificationResult.new("checked", 1.0, false)
+    @alias = Classification::Preview::Alias.new(category_name: nil, confidence: 0.0, included: true)
+    @merchant = Classification::Merchant::Result.new(category_name: "merchant")
+  end
+end
+"#)
+        .run_ruby(r#"
+preview = Classification::Preview.build
+aliased = Classification::Preview.aliased
+qualified = Classification::Preview.qualified
+merchant = Classification::Merchant.build
+raise "wrong declared class" unless preview.class == Classification::Preview::PreviewClassificationResult
+raise "alias created another class" unless aliased.class == preview.class && Classification::Preview::Alias == preview.class
+raise "member values changed" unless preview.category_name == "preview" && preview.confidence == 0.8 && preview.included == false
+raise "nil/zero/true changed" unless aliased.category_name.nil? && aliased.confidence == 0.0 && aliased.included == true
+raise "qualified positional constructor changed" unless qualified.category_name == "qualified" && qualified.confidence == 1.0 && qualified.included == false
+raise "same-named factory crossed owners" unless merchant.class == Classification::Merchant::Result && merchant.category_name == "merchant" && merchant.class != preview.class
+raise "Data lost immutability" unless preview.frozen? && !preview.respond_to?(:category_name=)
+puts "Data constants: exact owners, aliases, constructors, values, immutability passed"
+"#);
+    run.assert_passes();
+    let emitted =
+        std::fs::read_to_string(run.emitted.join("app/models/classification/preview.rb")).unwrap();
+    assert!(emitted.contains("Data.define"), "{emitted}");
+    assert!(!emitted.contains("constant not supported"), "{emitted}");
+}
+
+#[test]
+fn unrelated_names_and_nonliteral_or_shadowed_factories_are_not_admitted() {
+    let source = format!(
+        r#"{DECLARATIONS}
+module Other
+  class Data
+    def self.define(name)
+      name
+    end
+  end
+  class Shadowed
+    Result = Data.define(:name)
+  end
+end
+class DynamicFactory
+  MEMBER = :name
+  Result = Data.define(MEMBER)
+  WithBlock = Data.define(:name) {{ def custom; "custom"; end }}
+  Duplicate = Data.define(:name, :name)
+  def self.missing
+    Unrelated::Result.new(name: "wrong owner")
+  end
+end
+"#
+    );
+    let mut app = ingest_with_controller(&source, "Unrelated::Result.new(name: \"wrong owner\")");
+    let analyzer = Analyzer::new(&app);
+    for name in [
+        "Other::Shadowed::Result",
+        "DynamicFactory::Result",
+        "DynamicFactory::WithBlock",
+        "DynamicFactory::Duplicate",
+    ] {
+        assert!(
+            !analyzer
+                .class_registry()
+                .contains_key(&ClassId(Symbol::from(name))),
+            "{name}"
+        );
+    }
+    roundhouse::session::analyze_and_lower(&mut app);
+    let diagnostics = roundhouse::analyze::diagnose(&app);
+    assert!(
+        diagnostics.iter().any(|diagnostic| diagnostic.severity
+            == roundhouse::diagnostic::Severity::Error
+            && diagnostic.message.contains("Unrelated::Result")),
+        "a Result declaration elsewhere must not answer an unrelated constant: {diagnostics:?}"
+    );
+}
