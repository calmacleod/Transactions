+  raise "blank password queried database" unless sql.empty?
+  raise "blank password hashed or compared" unless creates.empty? && compares.empty?
+  sql = Db.capture_sql do
+    raise "blank missing account authenticated" unless Doorman.admit("missing@example.test", blank).nil?
+  end
+  raise "blank missing account queried database" unless sql.empty?
+  raise "blank missing account did BCrypt work" unless creates.empty? && compares.empty?
+end
