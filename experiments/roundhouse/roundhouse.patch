diff --git a/src/analyze/data.rs b/src/analyze/data.rs
new file mode 100644
index 00000000..505750d2
--- /dev/null
+++ b/src/analyze/data.rs
@@ -0,0 +1,128 @@
+//! Literal Ruby Data factories declare classes, despite being value assignments.
+//!
+//! Keep their source declaration identities and lexical owners from Rubydex.
+//! Aliases remain ordinary constant values in the analyzer's fixpoint; a name
+//! ending in `Result` is never evidence that it names one of these factories.
+
+use std::collections::{HashMap, HashSet};
+
+use crate::dialect::{ControllerBodyItem, ModelBodyItem};
+use crate::expr::{Expr, ExprNode, LValue, Literal};
+use crate::ident::{ClassId, Symbol};
+use crate::span::Span;
+use crate::ty::Ty;
+use crate::App;
+
+use super::body::ConstResolver;
+use super::ClassInfo;
+
+pub(super) fn register(
+    app: &App,
+    resolver: &ConstResolver,
+    classes: &mut HashMap<ClassId, ClassInfo>,
+) -> HashMap<Span, Ty> {
+    let mut factories = HashMap::new();
+    // Reopening the core class can replace `.define`; only the built-in
+    // factory is modeled here.
+    if app
+        .models
+        .iter()
+        .any(|class| class.name.0.as_str() == "Data")
+        || app
+            .library_classes
+            .iter()
+            .any(|class| class.name.0.as_str() == "Data")
+    {
+        return factories;
+    }
+    let mut register = |name: &Symbol, value: &Expr| {
+        let ExprNode::Send {
+            recv: Some(recv),
+            method,
+            args,
+            block: None,
+            ..
+        } = &*value.node
+        else {
+            return;
+        };
+        let ExprNode::Const { path } = &*recv.node else {
+            return;
+        };
+        if method.as_str() != "define" || !resolver.is_runtime_class(recv.span, path, "Data") {
+            return;
+        }
+        let mut members = HashSet::new();
+        for arg in args {
+            let ExprNode::Lit {
+                value: Literal::Sym { value: member },
+            } = &*arg.node
+            else {
+                return;
+            };
+            if !members.insert(member.clone()) {
+                return;
+            }
+        }
+        let Some(id) = resolver.constant_class(value.span, name.as_str()) else {
+            return;
+        };
+        if classes.contains_key(&id) {
+            return;
+        }
+        let instance = Ty::Class {
+            id: id.clone(),
+            args: vec![],
+        };
+        let mut info = ClassInfo::default();
+        info.class_methods
+            .insert(Symbol::from("new"), instance.clone());
+        // A member declaration establishes a reader, not its value type.
+        // Data has no generated writers.
+        for member in members {
+            info.instance_methods.insert(member, Ty::Untyped);
+        }
+        classes.insert(id, info);
+        factories.insert(value.span, instance);
+    };
+    let mut assignment = |expr: &Expr| {
+        if let ExprNode::Assign {
+            target: LValue::Const { path },
+            value,
+        } = &*expr.node
+        {
+            if let Some(name) = path.last() {
+                register(name, value);
+            }
+        }
+    };
+    for model in &app.models {
+        for item in &model.body {
+            if let ModelBodyItem::Unknown { expr, .. } = item {
+                assignment(expr);
+            }
+        }
+    }
+    for controller in &app.controllers {
+        for item in &controller.body {
+            if let ControllerBodyItem::Unknown { expr, .. } = item {
+                assignment(expr);
+            }
+        }
+    }
+    for class in &app.library_classes {
+        for (name, value) in &class.constants {
+            register(name, value);
+        }
+    }
+    for module in &app.test_modules {
+        for constants in std::iter::once(&module.constants)
+            .chain(module.inner_classes.iter().map(|inner| &inner.constants))
+        {
+            for (name, value) in constants {
+                register(name, value);
+            }
+        }
+    }
+    factories
+}
diff --git a/src/lower/decimal.rs b/src/lower/decimal.rs
new file mode 100644
index 00000000..989e73a5
--- /dev/null
+++ b/src/lower/decimal.rs
@@ -0,0 +1,19 @@
+//! BigDecimal util conversions without reopening native builtin types.
+use crate::app::App;
+use crate::expr::{Expr, ExprNode};
+use crate::ident::{ClassId, Symbol};
+use crate::ty::Ty;
+
+pub fn apply_decimal_grounding(app: &mut App) {
+    super::for_each_hook_body(app, &mut rewrite);
+}
+fn rewrite(e: &mut Expr) {
+    e.node.for_each_child_mut(&mut rewrite);
+    let ExprNode::Send { recv: Some(r), method, args, block: None, .. } = &*e.node else { return; };
+    if method.as_str() != "to_d" || !args.is_empty() { return; }
+    let text = Expr::new(e.span, ExprNode::Send {
+        recv: Some(r.clone()), method: Symbol::from("to_s"), args: vec![], block: None, parenthesized: false,
+    });
+    *e.node = ExprNode::Send { recv: None, method: Symbol::from("BigDecimal"), args: vec![text], block: None, parenthesized: true };
+    e.ty = Some(Ty::Class { id: ClassId(Symbol::from("BigDecimal")), args: vec![] });
+}
diff --git a/src/lower/normalizes.rs b/src/lower/normalizes.rs
new file mode 100644
index 00000000..5cb9dbf3
--- /dev/null
+++ b/src/lower/normalizes.rs
@@ -0,0 +1,167 @@
+//! The bounded String normalizer used by ordinary Rails authentication:
+//! `normalizes :email_address, with: ->(value) { value.strip.downcase }`.
+//! One declaration reader and one value expansion serve login lookup and
+//! public model writers. Hydration must bypass the writer, as in Rails.
+//! Arbitrary lambdas, inherited declarations and apply_to_nil: true are
+//! not claimed by this grounding.
+
+use crate::dialect::{Model, ModelBodyItem};
+use crate::expr::{Expr, ExprNode, Literal};
+use crate::ident::Symbol;
+use crate::span::Span;
+use crate::ty::Ty;
+use std::collections::HashSet;
+
+pub(crate) fn strip_downcase_attributes(model: &Model) -> HashSet<Symbol> {
+    let mut normalized = HashSet::new();
+    for item in &model.body {
+        let ModelBodyItem::Unknown { expr, .. } = item else {
+            continue;
+        };
+        let ExprNode::Send {
+            recv: None,
+            method,
+            args,
+            block: None,
+            ..
+        } = &*expr.node
+        else {
+            continue;
+        };
+        if method.as_str() != "normalizes" {
+            continue;
+        }
+        let Some(ExprNode::Hash { entries, .. }) = args.last().map(|a| &*a.node) else {
+            continue;
+        };
+        let mut normalizer = None;
+        let mut supported = true;
+        for (key, value) in entries {
+            match &*key.node {
+                ExprNode::Lit {
+                    value: Literal::Sym { value: key },
+                } if key.as_str() == "with" => {
+                    normalizer = Some(value);
+                }
+                ExprNode::Lit {
+                    value: Literal::Sym { value: key },
+                } if key.as_str() == "apply_to_nil"
+                    && matches!(
+                        &*value.node,
+                        ExprNode::Lit {
+                            value: Literal::Bool { value: false }
+                        }
+                    ) => {}
+                _ => supported = false,
+            }
+        }
+        let Some(ExprNode::Lambda {
+            params,
+            rest_param: None,
+            block_param: None,
+            body,
+            ..
+        }) = normalizer.map(|e| &*e.node)
+        else {
+            continue;
+        };
+        if !supported || params.len() != 1 {
+            continue;
+        }
+        let body = match &*body.node {
+            ExprNode::Seq { exprs } if exprs.len() == 1 => &exprs[0],
+            _ => body,
+        };
+        let ExprNode::Send {
+            recv: Some(strip),
+            method,
+            args: down_args,
+            block: None,
+            ..
+        } = &*body.node
+        else {
+            continue;
+        };
+        let ExprNode::Send {
+            recv: Some(value),
+            method: strip_method,
+            args: strip_args,
+            block: None,
+            ..
+        } = &*strip.node
+        else {
+            continue;
+        };
+        if method.as_str() != "downcase"
+            || strip_method.as_str() != "strip"
+            || !down_args.is_empty()
+            || !strip_args.is_empty()
+            || !matches!(&*value.node, ExprNode::Var { name, .. } if name == &params[0])
+        {
+            continue;
+        }
+        for attr in &args[..args.len() - 1] {
+            let ExprNode::Lit {
+                value: Literal::Sym { value: name },
+            } = &*attr.node
+            else {
+                continue;
+            };
+            let string_column = match model.attributes.fields.get(name) {
+                Some(Ty::Str) => true,
+                Some(Ty::Union { variants }) => {
+                    variants.iter().all(|t| matches!(t, Ty::Str | Ty::Nil))
+                }
+                _ => false,
+            };
+            if string_column {
+                normalized.insert(name.clone());
+            }
+        }
+    }
+    normalized
+}
+
+/// Values are stable local reads at both callers, so the nil test never
+/// repeats evaluation of an arbitrary source expression.
+pub(crate) fn normalize_string(value: Expr, span: Span, nullable: bool) -> Expr {
+    let send = |recv: Expr, method: &str, ty: Ty| {
+        let mut expr = Expr::new(
+            span,
+            ExprNode::Send {
+                recv: Some(recv),
+                method: Symbol::from(method),
+                args: vec![],
+                block: None,
+                parenthesized: false,
+            },
+        );
+        expr.ty = Some(ty);
+        expr
+    };
+    let normalized = send(
+        send(send(value.clone(), "to_s", Ty::Str), "strip", Ty::Str),
+        "downcase",
+        Ty::Str,
+    );
+    if !nullable {
+        return normalized;
+    }
+    let mut result = Expr::new(
+        span,
+        ExprNode::If {
+            cond: send(value, "nil?", Ty::Bool),
+            then_branch: Expr::new(
+                span,
+                ExprNode::Lit {
+                    value: Literal::Nil,
+                },
+            ),
+            else_branch: normalized,
+        },
+    );
+    result.ty = Some(Ty::Union {
+        variants: vec![Ty::Str, Ty::Nil],
+    });
+    result
+}
diff --git a/src/lower/routes_to_library/ruby.rs b/src/lower/routes_to_library/ruby.rs
new file mode 100644
index 00000000..96f76ddc
--- /dev/null
+++ b/src/lower/routes_to_library/ruby.rs
@@ -0,0 +1,114 @@
+//! Ruby-family route segments keep their value until the checked
+//! ActiveSupport.to_param boundary. Scalar-only signatures remain the
+//! contract of the other targets; Object here preserves a record's tag
+//! under Spinel rather than coercing it to Integer/String before dispatch.
+
+use std::collections::{HashMap, HashSet};
+
+use crate::app::App;
+use crate::dialect::LibraryFunction;
+use crate::expr::{Expr, ExprNode, InterpPart};
+use crate::ident::{ClassId, Symbol};
+use crate::ty::Ty;
+
+pub fn lower_route_helpers(app: &App) -> Vec<LibraryFunction> {
+    let flat = super::flatten_routes(app);
+    let mut segments: HashMap<String, HashSet<String>> = HashMap::new();
+    for route in flat.iter().filter(|route| route.named) {
+        segments
+            .entry(format!("{}_path", route.as_name))
+            .or_default()
+            .extend(
+                route
+                    .path_params
+                    .iter()
+                    .filter(|name| name.as_str() != "format")
+                    .cloned(),
+            );
+    }
+    let declared = segments.keys().cloned().collect();
+    for (name, (base, _)) in super::format_variant_demand(app, &declared) {
+        if let Some(names) = segments.get(&format!("{base}_path")).cloned() {
+            segments.insert(name, names);
+        }
+    }
+    let direct: HashSet<String> = app
+        .routes
+        .direct_helpers
+        .iter()
+        .map(|helper| format!("{}_path", helper.name.as_str()))
+        .collect();
+    let mut functions = super::lower_routes_to_library_functions(app);
+    for function in &mut functions {
+        if direct.contains(function.name.as_str()) {
+            continue;
+        }
+        let Some(names) = segments.get(function.name.as_str()) else {
+            continue;
+        };
+        if let Some(Ty::Fn { params, .. }) = &mut function.signature {
+            for param in params {
+                if names.contains(param.name.as_str()) {
+                    param.ty = object_ty();
+                }
+            }
+        }
+        normalize_segments(&mut function.body, names);
+    }
+    functions
+}
+
+fn object_ty() -> Ty {
+    Ty::Class {
+        id: ClassId(Symbol::from("Object")),
+        args: vec![],
+    }
+}
+
+fn normalize_segments(expr: &mut Expr, names: &HashSet<String>) {
+    expr.node
+        .for_each_child_mut(&mut |child| normalize_segments(child, names));
+    if let ExprNode::Var { name, .. } = &*expr.node {
+        if names.contains(name.as_str()) {
+            expr.ty = Some(object_ty());
+        }
+    }
+    let ExprNode::StringInterp { parts } = &mut *expr.node else {
+        return;
+    };
+    for part in parts {
+        let InterpPart::Expr { expr: value } = part else {
+            continue;
+        };
+        if !matches!(&*value.node, ExprNode::Var { name, .. } if names.contains(name.as_str())) {
+            continue;
+        }
+        let mut normalized = Expr::new(
+            value.span,
+            ExprNode::Send {
+                recv: Some(Expr::new(
+                    value.span,
+                    ExprNode::Const {
+                        path: vec![Symbol::from("ActiveSupport")],
+                    },
+                )),
+                method: Symbol::from("to_param"),
+                args: vec![value.clone()],
+                block: None,
+                parenthesized: true,
+            },
+        );
+        normalized.ty = Some(Ty::Str);
+        *value = normalized;
+    }
+}
+
+/// Keep the shape/arity table but leave records intact at Ruby call sites.
+/// Other targets continue to project scalar ids with helper_id_segments.
+pub fn helper_id_segments(app: &App) -> HashMap<String, Vec<bool>> {
+    let mut shapes = crate::lower::routes::helper_id_segments(app);
+    for shape in shapes.values_mut() {
+        shape.fill(false);
+    }
+    shapes
+}
diff --git a/src/lower/string_truncate.rs b/src/lower/string_truncate.rs
new file mode 100644
index 00000000..501fdefa
--- /dev/null
+++ b/src/lower/string_truncate.rs
@@ -0,0 +1,142 @@
+//! ActiveSupport's String#truncate uses a positional limit; the shared
+//! ViewHelpers runtime takes that limit as a keyword. Ground only typed
+//! String calls in the runtime's implemented limit/omission surface.
+use crate::app::App;
+use crate::diagnostic::Diagnostic;
+use crate::dialect::MethodReceiver;
+use crate::expr::{Expr, ExprNode, Literal};
+use crate::ident::Symbol;
+use crate::ty::Ty;
+
+pub fn apply_string_truncate_lowering(app: &mut App) -> Vec<Diagnostic> {
+    // A builtin type stamp does not authorize replacing an app's reopen.
+    // Includes/mixins are conservatively retained even when their method
+    // lookup cannot be resolved here.
+    let reopened = app.library_classes.iter().any(|class| {
+        class.name.0.as_str() == "String"
+            && (!class.includes.is_empty()
+                || !class.unknown_calls.is_empty()
+                || class.methods.iter().any(|method| {
+                    method.receiver == MethodReceiver::Instance
+                        && matches!(method.name.as_str(), "truncate" | "+")
+                }))
+    }) || app
+        .module_mixins
+        .iter()
+        .any(|mixin| mixin.target.as_str() == "String");
+    if reopened {
+        return Vec::new();
+    }
+    let mut diagnostics = Vec::new();
+    super::for_each_hook_body(app, &mut |body| rewrite(body, &mut diagnostics));
+    for view in &mut app.views {
+        rewrite(&mut view.body, &mut diagnostics);
+    }
+    diagnostics
+}
+
+fn rewrite(expr: &mut Expr, diagnostics: &mut Vec<Diagnostic>) {
+    expr.node
+        .for_each_child_mut(&mut |child| rewrite(child, diagnostics));
+    let ExprNode::Send {
+        recv: Some(receiver),
+        method,
+        args,
+        block,
+        ..
+    } = &*expr.node
+    else {
+        return;
+    };
+    if method.as_str() != "truncate" || !matches!(receiver.ty.as_ref(), Some(Ty::Str)) {
+        return;
+    }
+    let omission = if args.len() == 2 {
+        match &*args[1].node {
+            ExprNode::Hash { entries, .. } if entries.is_empty() => Some(None),
+            ExprNode::Hash { entries, .. } if entries.len() == 1 => {
+                let (key, value) = &entries[0];
+                (matches!(&*key.node, ExprNode::Lit { value: Literal::Sym { value: name } } if name.as_str() == "omission")
+                    && matches!(value.ty.as_ref(), Some(Ty::Str))).then_some(Some(value.clone()))
+            }
+            _ => None,
+        }
+    } else if args.len() == 1 {
+        Some(None)
+    } else {
+        None
+    };
+    if block.is_some()
+        || !args
+            .first()
+            .is_some_and(|limit| matches!(limit.ty.as_ref(), Some(Ty::Int)))
+        || omission.is_none()
+    {
+        diagnostics.push(Diagnostic::unsupported(expr.span, None, "String#truncate",
+            "requires an Integer positional limit, optional literal omission: String option, and no block; separator and dynamic option hashes are not implemented"));
+        return;
+    }
+    let mut entries = vec![(keyword(expr, "length"), args[0].clone())];
+    if let Some(value) = omission.unwrap() {
+        entries.push((keyword(expr, "omission"), value));
+    }
+    let mut helper = Expr::new(
+        expr.span,
+        ExprNode::Send {
+            recv: Some(Expr::new(
+                expr.span,
+                ExprNode::Const {
+                    path: vec![Symbol::from("ActionView"), Symbol::from("ViewHelpers")],
+                },
+            )),
+            method: Symbol::from("truncate"),
+            args: vec![
+                receiver.clone(),
+                Expr::new(
+                    expr.span,
+                    ExprNode::Hash {
+                        entries,
+                        kwargs: true,
+                    },
+                ),
+            ],
+            block: None,
+            parenthesized: true,
+        },
+    );
+    helper.ty = Some(Ty::Str);
+    // String#truncate always returns a fresh mutable String, even when
+    // no truncation occurs. The existing view helper returns its input
+    // in that case. String addition returns a fresh mutable value and
+    // is modeled across targets, unlike builtin String#dup.
+    let mut empty = Expr::new(
+        expr.span,
+        ExprNode::Lit {
+            value: Literal::Str {
+                value: String::new(),
+            },
+        },
+    );
+    empty.ty = Some(Ty::Str);
+    *expr.node = ExprNode::Send {
+        recv: Some(helper),
+        method: Symbol::from("+"),
+        args: vec![empty],
+        block: None,
+        parenthesized: false,
+    };
+    expr.ty = Some(Ty::Str);
+}
+
+fn keyword(expr: &Expr, name: &str) -> Expr {
+    let mut key = Expr::new(
+        expr.span,
+        ExprNode::Lit {
+            value: Literal::Sym {
+                value: Symbol::from(name),
+            },
+        },
+    );
+    key.ty = Some(Ty::Sym);
+    key
+}
diff --git a/tests/association_id_reader_registry.rs b/tests/association_id_reader_registry.rs
new file mode 100644
index 00000000..e462490b
--- /dev/null
+++ b/tests/association_id_reader_registry.rs
@@ -0,0 +1,100 @@
+//! Generated has_many ID readers must exist in analysis before model lowering.
+
+use std::collections::HashMap;
+use std::path::PathBuf;
+
+use roundhouse::analyze::Analyzer;
+use roundhouse::ident::{ClassId, Symbol};
+use roundhouse::ty::Ty;
+
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+#[test]
+fn generated_id_readers_keep_their_owner_and_custom_getters_keep_their_type() {
+    let files = [
+        ("db/schema.rb", "ActiveRecord::Schema.define do\n create_table :workspaces do |t|; end\n create_table :memberships do |t|; t.integer :workspace_id; t.integer :receipt_id; end\n create_table :receipts do |t|; end\nend"),
+        ("app/models/workspace.rb", "class Workspace < ApplicationRecord\n has_many :memberships\n has_many :receipts, through: :memberships\n has_many :manual_receipts, class_name: \"Receipt\"\n def manual_receipt_ids; \"owned\"; end\nend"),
+        ("app/models/membership.rb", "class Membership < ApplicationRecord\n belongs_to :workspace\n belongs_to :receipt\nend"),
+        ("app/models/receipt.rb", "class Receipt < ApplicationRecord\nend"),
+    ];
+    let tree: HashMap<PathBuf, Vec<u8>> = files
+        .into_iter()
+        .map(|(path, source)| (path.into(), source.as_bytes().to_vec()))
+        .collect();
+    let mut app = roundhouse::ingest::ingest_app_from_tree(tree).unwrap();
+    let mut analyzer = Analyzer::new(&app);
+    let workspace = ClassId(Symbol::from("Workspace"));
+    let receipt = ClassId(Symbol::from("Receipt"));
+    let array_of_int = Ty::Array {
+        elem: Box::new(Ty::Int),
+    };
+    for name in ["membership_ids", "receipt_ids"] {
+        assert_eq!(
+            analyzer.class_registry()[&workspace]
+                .instance_methods
+                .get(&Symbol::from(name)),
+            Some(&array_of_int)
+        );
+        assert!(
+            !analyzer.class_registry()[&receipt]
+                .instance_methods
+                .contains_key(&Symbol::from(name)),
+            "association IDs must not leak to the target model"
+        );
+    }
+    assert!(
+        !analyzer.class_registry()[&workspace]
+            .instance_methods
+            .contains_key(&Symbol::from("manual_receipt_ids")),
+        "a custom getter must not receive the generated array signature"
+    );
+    analyzer.analyze(&mut app);
+    assert_eq!(
+        analyzer.class_registry()[&workspace]
+            .instance_methods
+            .get(&Symbol::from("manual_receipt_ids")),
+        Some(&Ty::Str)
+    );
+}
+
+#[test]
+fn generated_direct_and_concern_through_id_calls_check_cleanly_and_run() {
+    let declarations = r#"  has_many :comments, dependent: :destroy
+  module Links
+    extend ActiveSupport::Concern
+    included { has_many :linked_articles, through: :comments, source: :article }
+  end
+  include Links
+  has_many :manual_comments, class_name: "Comment", foreign_key: :article_id
+
+  def projected_comment_ids
+    comment_ids
+  end
+
+  def self.linked_ids_for(id)
+    find(id).linked_article_ids
+  end
+
+  def manual_comment_ids
+    "owned"
+  end
+"#;
+    let run = emit_and_run::real_blog()
+        .edit("app/models/article.rb", "  has_many :comments, dependent: :destroy", declarations)
+        .run_ruby(r#"
+a = Article.create!(title: "First", body: "Long enough article body")
+b = Article.create!(title: "Second", body: "Another long article body")
+ca = Comment.create!(article_id: a.id, commenter: "A", body: "first comment")
+cb = Comment.create!(article_id: b.id, commenter: "B", body: "second comment")
+raise "direct ID reader crossed owners" unless a.projected_comment_ids == [ca.id] && b.projected_comment_ids == [cb.id]
+raise "through ID reader crossed owners" unless Article.linked_ids_for(a.id) == [a.id] && Article.linked_ids_for(b.id) == [b.id]
+raise "custom ID getter was overwritten" unless a.manual_comment_ids == "owned"
+raise "ID reader leaked to target" if Comment.new.respond_to?(:linked_article_ids)
+puts "association IDs: direct, Concern through, ownership, custom getter passed"
+"#);
+    run.assert_passes();
+    let emitted = std::fs::read_to_string(run.emitted.join("app/models/article.rb")).unwrap();
+    assert!(emitted.contains("def comment_ids"), "{emitted}");
+    assert!(emitted.contains("def linked_article_ids"), "{emitted}");
+}
