+    fn gap(e: &Expr) -> Option<(crate::span::Span, String)> {
+        if let ExprNode::Const { path } = &*e.node {
+            let names = path.iter().filter(|s| !s.as_str().is_empty()).map(|s| s.as_str()).collect::<Vec<_>>();
+            if names.first() == Some(&"Date") && names.len() > 1 && names != ["Date", "DAYNAMES"] {
+                return Some((e.span, format!("Spinel does not provide {}", names.join("::"))));
+            }
+        }
+        if let ExprNode::Send { recv: Some(recv), method, args, .. } = &*e.node {
+            let date_const = matches!(&*recv.node, ExprNode::Const { path }
+                if path.last().is_some_and(|p| p.as_str() == "Date") && (path.len() == 1 || (path.len() == 2 && path[0].as_str().is_empty())));
+            let date_value = recv.ty.as_ref().is_some_and(date) && !date_const;
+            if date_const {
+                let ok = match method.as_str() {
+                    "new" | "civil" => (1..=3).contains(&args.len()) && args.iter().all(|a| matches!(a.ty, Some(Ty::Int))),
+                    "current" | "today" => args.is_empty(),
