+/// Admission is bounded by the executable runtime, not by the native
+/// Ruby Date method table. Other targets retain their Date rejection.
+fn reject_unsupported_spinel_dates(app: &App) -> Result<(), String> {
+    use crate::expr::{Expr, ExprNode, Literal};
+    use crate::ty::Ty;
+    fn date(t: &Ty) -> bool {
+        matches!(t, Ty::Date) || matches!(t, Ty::Union { variants }
+            if variants.iter().any(|v| matches!(v, Ty::Date)) && variants.iter().all(|v| matches!(v, Ty::Date | Ty::Nil)))
