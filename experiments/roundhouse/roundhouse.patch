new file mode 100644
index 00000000..e4469d64
--- /dev/null
+++ b/tests/keyword_rest_hash_grounding.rs
@@ -0,0 +1,301 @@
+//! A Ruby keyword-rest binding is always a Hash, including when no in-app
+//! call site supplies a member type. Shallow key conversion returns a copy.
+use roundhouse::analyze::Analyzer;
+use roundhouse::ident::Symbol;
+use roundhouse::ty::Ty;
+
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+fn unknown_hash() -> Ty {
+    Ty::Hash {
+        key: Box::new(Ty::Untyped),
+        value: Box::new(Ty::Untyped),
+    }
+}
+
+#[test]
+fn unobserved_keyword_rest_has_a_hash_shape_without_inventing_key_types() {
+    let sources = [
+        ("db/schema.rb", "ActiveRecord::Schema.define do\n create_table :records do |t|; t.string :name; end\nend"),
+        ("app/models/record.rb", "class Record < ApplicationRecord\n def capture(**filters)\n filters\n end\nend"),
+        ("app/services/keyword_capture.rb", "class KeywordCapture\n def capture(**filters)\n filters\n end\n def required(label:, **filters)\n filters\n end\nend"),
+    ];
+    let mut app = roundhouse::ingest::ingest_app_from_tree(
+        sources
+            .into_iter()
+            .map(|(path, text)| (path.into(), text.as_bytes().to_vec()))
+            .collect(),
+    )
+    .unwrap();
+    Analyzer::new(&app).analyze(&mut app);
+    let record = app
+        .models
+        .iter()
+        .find(|model| model.name.0.as_str() == "Record")
+        .unwrap();
+    assert_eq!(
+        record.methods().next().unwrap().body.ty,
+        Some(unknown_hash())
+    );
+    let capture = app
+        .library_classes
+        .iter()
+        .find(|class| class.name.0.as_str() == "KeywordCapture")
+        .unwrap();
+    for name in ["capture", "required"] {
+        assert_eq!(
+            capture
+                .methods
+                .iter()
+                .find(|method| method.name.as_str() == name)
+                .unwrap()
+                .body
+                .ty,
+            Some(unknown_hash()),
+            "{name}: no observation does not mean Symbol keys"
+        );
+    }
+}
+
+const PROBE: &str = r#"class KeywordHashProbe
+  def convert(**filters)
+    filters.stringify_keys
+  end
+
+  def self.string_copy
+    original = { "kept" => 0 }
+    converted = original.stringify_keys
+    converted["added"] = false
+    [original, converted]
+  end
+end
+"#;
+
+#[test]
+fn emitted_keyword_rest_converts_arbitrary_keys_and_preserves_values() {
+    let run = emit_and_run::real_blog()
+        .write("app/services/keyword_hash_probe.rb", PROBE)
+        .run_ruby(r#"
+probe = KeywordHashProbe.new
+raise "empty keyword-rest" unless probe.convert == {}
+input = { query: "market", "start_date" => "2021-03-17", 17 => false, nil_value: nil, count: 0, nested: { "kept" => [1, 2] } }
+expected = { "query" => "market", "start_date" => "2021-03-17", "17" => false, "nil_value" => nil, "count" => 0, "nested" => { "kept" => [1, 2] } }
+raise "arbitrary keyword keys or values changed" unless probe.convert(**input) == expected
+raise "source keys changed" unless input.key?(:query) && input.key?(17)
+puts "keyword-rest: arbitrary keys and nil/false/zero/nested values passed"
+"#);
+    run.assert_passes();
+    let emitted =
+        std::fs::read_to_string(run.emitted.join("app/models/keyword_hash_probe.rb")).unwrap();
+    assert!(
+        emitted.contains("ActiveSupport.stringify_keys(filters)"),
+        "{emitted}"
+    );
+    assert!(!emitted.contains("filters.stringify_keys"), "{emitted}");
+}
+
+#[test]
+fn emitted_string_key_conversion_returns_an_independent_hash() {
+    emit_and_run::real_blog().write("app/services/keyword_hash_probe.rb", PROBE)
+        .run_ruby(r#"
+original, converted = KeywordHashProbe.string_copy
+raise "nonbang String-key result aliases receiver" unless original == { "kept" => 0 } && converted == { "kept" => 0, "added" => false }
+raise "new Hash identity lost" if original.equal?(converted)
+puts "String-key conversion: independent mutable Hash passed"
+"#).assert_passes();
+}
+
+#[test]
+fn an_opaque_keys_custom_to_s_result_is_not_falsely_typed_as_string() {
+    let run = emit_and_run::real_blog()
+        .write("app/services/keyword_hash_probe.rb", PROBE)
+        .write("app/services/odd_key.rb", "class OddKey\n def to_s\n 17\n end\nend\n")
+        .run_ruby("result = KeywordHashProbe.new.convert(**{ OddKey.new => 'kept' })\nraise 'custom key result changed' unless result == { 17 => 'kept' }\n");
+    run.assert_passes();
+    let mut app = roundhouse::ingest::ingest_app_from_tree(
+        [(
+            "app/services/keyword_hash_probe.rb".into(),
+            PROBE.as_bytes().to_vec(),
+        )]
+        .into_iter()
+        .collect(),
+    )
+    .unwrap();
+    roundhouse::session::analyze_and_lower(&mut app);
+    let class = app
+        .library_classes
+        .iter()
+        .find(|class| class.name.0.as_str() == "KeywordHashProbe")
+        .unwrap();
+    let method = class
+        .methods
+        .iter()
+        .find(|method| method.name.as_str() == "convert")
+        .unwrap();
+    assert_eq!(
+        method.body.ty,
+        Some(unknown_hash()),
+        "opaque keys have no String guarantee"
+    );
+    assert!(
+        matches!(method.signature.as_ref(), Some(Ty::Fn { ret, .. })
+        if **ret == unknown_hash()),
+        "opaque sidecar must agree: {:?}",
+        method.signature
+    );
+}
+
+#[test]
+fn reopened_string_and_symbol_key_conversions_keep_their_actual_result_types() {
+    let source = r#"class String
+  def to_s
+    self == "kept" ? 17 : self
+  end
+end
+class Symbol
+  def to_s
+    self == :kept_symbol ? 23 : self.name
+  end
+end
+class ReopenedKeyProbe
+  def self.string_keys
+    { "kept" => 0 }.stringify_keys
+  end
+  def self.symbol_keys
+    { kept_symbol: false }.stringify_keys
+  end
+end
+"#;
+    emit_and_run::real_blog()
+        .write("app/services/reopened_key_probe.rb", source)
+        .run_ruby("raise 'String key dispatch changed' unless ReopenedKeyProbe.string_keys == { 17 => 0 }\nraise 'Symbol key dispatch changed' unless ReopenedKeyProbe.symbol_keys == { 23 => false }\n")
+        .assert_passes();
+    let mut app = roundhouse::ingest::ingest_app_from_tree(
+        [(
+            "app/services/reopened_key_probe.rb".into(),
+            source.as_bytes().to_vec(),
+        )]
+        .into_iter()
+        .collect(),
+    )
+    .unwrap();
+    roundhouse::session::analyze_and_lower(&mut app);
+    let class = app
+        .library_classes
+        .iter()
+        .find(|class| class.name.0.as_str() == "ReopenedKeyProbe")
+        .unwrap();
+    for name in ["string_keys", "symbol_keys"] {
+        let method = class
+            .methods
+            .iter()
+            .find(|method| method.name.as_str() == name)
+            .unwrap();
+        assert!(
+            matches!(method.body.ty.as_ref(), Some(Ty::Hash { key, .. })
+            if **key == Ty::Untyped),
+            "{name}: {:?}",
+            method.body.ty
+        );
+        assert!(
+            matches!(method.signature.as_ref(), Some(Ty::Fn { ret, .. })
+            if matches!(&**ret, Ty::Hash { key, .. } if **key == Ty::Untyped)),
+            "{name}: sidecar must preserve the uncertain key: {:?}",
+            method.signature
+        );
+    }
+}
+
+#[test]
+fn keyword_rest_keeps_observed_members_and_does_not_retype_optional_positionals() {
+    let mut app = roundhouse::ingest::ingest_app_from_tree(
+        [(
+            "app/services/observed_keywords.rb".into(),
+            br#"class ObservedKeywords
+  def capture(**filters)
+    filters
+  end
+  def caller
+    capture(query: "market")
+  end
+  def optional(filters = {})
+    filters
+  end
+end
+"#
+            .to_vec(),
+        )]
+        .into_iter()
+        .collect(),
+    )
+    .unwrap();
+    Analyzer::new(&app).analyze(&mut app);
+    let class = app
+        .library_classes
+        .iter()
+        .find(|class| class.name.0.as_str() == "ObservedKeywords")
+        .unwrap();
+    let capture = class
+        .methods
+        .iter()
+        .find(|method| method.name.as_str() == "capture")
+        .unwrap();
+    assert_eq!(
