@@ -0,0 +1,36 @@
+//! Remaining experiment regressions; merged form and route behavior is covered upstream.
+use std::{collections::HashMap, path::PathBuf};
+
+#[test]
+fn contextual_defaults_and_instance_keywords_keep_named_binding() {
+    let files = [
+        ("db/schema.rb", "ActiveRecord::Schema.define do\n create_table :users do |t|\n t.string :name\n end\nend"),
+        ("app/models/user.rb", "class User < ApplicationRecord\nend"),
+        ("app/controllers/users_controller.rb", "class UsersController < ApplicationController\n def show\n Report.new(user: User.find(params[:id])).call(schema: nil)\n end\nend"),
+    ];
+    let tree: HashMap<PathBuf, Vec<u8>> = files.into_iter().map(|(p,s)| (p.into(), s.as_bytes().to_vec())).collect();
+    let mut app = roundhouse::ingest::ingest_app_from_tree(tree).unwrap();
+    app.library_classes.extend(roundhouse::ingest::ingest_library_classes(b"class Report\n def initialize(model: Current.user, user: nil)\n @model=model\n @user=user\n end\n def call(start_date: Time.now, schema: nil)\n start_date\n end\nend", "app/services/report.rb").unwrap());
+    roundhouse::session::analyze_and_lower(&mut app);
+    let mut files = roundhouse::emit::ruby::emit_spinel(&app);
+    files.extend(roundhouse::emit::ruby::emit_library(&app));
+    let source = files.iter().map(|file| file.content.as_str()).collect::<Vec<_>>().join("\n");
+    assert!(source.contains("def initialize(model:"), "context default must stay in callee: {}", files.iter().filter(|f| f.path.to_string_lossy().contains("report") || f.path.to_string_lossy().contains("users_controller")).map(|f| f.content.as_str()).collect::<Vec<_>>().join("\n"));
+    assert!(source.contains("def call(start_date:"), "instance method keeps named binding");
+    assert!(source.contains("Report.new(user:"), "caller can omit the context default");
+    assert!(source.contains(".call(schema:"), "schema must not bind to start_date");
+}
+
+#[test]
+fn nested_array_rows_use_scalar_permit_on_emitted_hashes() {
+    let files = [
+        ("app/controllers/imports_controller.rb", "class ImportsController < ApplicationController\n def create\n render json: permitted_rows\n end\n private\n def permitted_rows\n params.require(:import).fetch(\"rows\", []).map { |row| row.permit(:id, :included) }\n end\nend"),
+    ];
+    let tree: HashMap<PathBuf, Vec<u8>> = files.into_iter().map(|(p,s)| (p.into(), s.as_bytes().to_vec())).collect();
+    let mut app = roundhouse::ingest::ingest_app_from_tree(tree).unwrap();
+    roundhouse::session::analyze_and_lower(&mut app);
+    let files = roundhouse::emit::ruby::emit_spinel(&app);
+    let source = &files.iter().find(|f| f.path.ends_with("app/controllers/imports_controller.rb")).unwrap().content;
+    assert!(source.contains("Params.permit_scalars(row,"), "{source}");
+    assert!(!source.contains("row.permit("), "{source}");
+}
