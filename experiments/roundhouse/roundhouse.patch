diff --git a/runtime/ruby/date_range.rb b/runtime/ruby/date_range.rb
new file mode 100644
index 00000000..866e38f9
--- /dev/null
+++ b/runtime/ruby/date_range.rb
@@ -0,0 +1,41 @@
+# Shared SQL semantics for a date interval. The lowerer supplies the
+# schema-qualified column; bounds pass through the ordinary adapter escape
+# contract, so SQL and storage use the same representation on every target.
+module ActiveSupport
+  def self.to_date(time)
+    Date.new(time.year, time.mon, time.mday)
+  end
+
+  def self.current_date
+    to_date(now)
+  end
+
+  def self.date_beginning_of_month(date)
+    Date.new(date.year, date.month, 1)
+  end
+
+  def self.date_end_of_month(date)
+    (date_beginning_of_month(date) >> 1) - 1
+  end
+
+  def self.date_beginning_of_week(date)
+    date - (date.wday + 6) % 7
+  end
+
+  def self.date_end_of_week(date)
+    date_beginning_of_week(date) + 6
+  end
+
+  def self.date_advance(date, years, months, weeks, days)
+    ((date >> (years * 12)) >> months) + weeks * 7 + days
+  end
+
+  def self.date_range_condition(range, column)
+    parts = []
+    first = range.begin
+    last = range.end
+    parts << "#{column} >= #{ActiveRecord.adapter.escape_value(first)}" unless first.nil?
+    parts << "#{column} #{range.exclude_end? ? '<' : '<='} #{ActiveRecord.adapter.escape_value(last)}" unless last.nil?
+    parts.empty? ? '1=1' : '(' + parts.join(' AND ') + ')'
+  end
+end
