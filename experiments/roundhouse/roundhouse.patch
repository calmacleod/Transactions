+    def initialize(digest)
+      @test_digest = digest
+    end
+
+    def ==(secret)
+      @test_digest == "test digest:" + secret
+    end
+
+    def to_s
+      @test_digest
+    end
+  end
+end
+user = User.create!(email_address: "  ADMIN@EXAMPLE.TEST  ", password_digest: BCrypt::Password.create("correct password").to_s)
+raise "create did not normalize email" unless user.email_address == "admin@example.test"
+raise "normalized email not stored" unless User.find(user.id).email_address == "admin@example.test"
+user.email_address = "  RENAMED@EXAMPLE.TEST  "
+raise "direct setter did not normalize" unless user.email_address == "renamed@example.test"
+user.email_address = nil
+raise "normalizer changed nil" unless user.email_address.nil?
+user.update!(email_address: "  ADMIN@EXAMPLE.TEST  ")
