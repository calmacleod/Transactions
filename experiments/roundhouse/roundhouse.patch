@@ -0,0 +1,126 @@
+//! Literal Arrays are concrete even when an external element is opaque.
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+#[test]
+fn emitted_model_defaults_filter_opaque_elements_without_core_reopens() {
+    let run = emit_and_run::real_blog()
+        .edit("app/models/article.rb", "class Article < ApplicationRecord", r#"class Article < ApplicationRecord
+  def self.configured_model_ids(config)
+    feature_setting = nil
+    [feature_setting, ENV["ROUNDHOUSE_COMPACT_FEATURE"].presence, model_id,
+      ENV["ROUNDHOUSE_COMPACT_GLOBAL"].presence, config.default_model].compact_blank.uniq
+  end
+
+  def self.model_id
+    "known-model"
+  end
+
+  def self.unknown_collection(value)
+    value.compact_blank
+  end
+"#)
+        .write("app/models/article.rbs", r#"
+class Article
+  def self.configured_model_ids: (untyped config) -> Array[untyped]
+  def self.unknown_collection: (untyped value) -> untyped
+end
+"#)
+        .run_ruby(r#"
+class Array
+  undef_method :compact_blank if method_defined?(:compact_blank)
+end
+class Hash
+  undef_method :compact_blank if method_defined?(:compact_blank)
+end
+class DefaultReader
+  attr_reader :reads
+  def initialize(value)
+    @value = value
+    @reads = 0
+  end
+  def default_model
+    @reads += 1
+    @value
+  end
+end
+class OwnedBlank
+  def blank?; "truthy"; end
+  def to_s; "present"; end
+end
+class OwnedPresent
+  def blank?; nil; end
+  def empty?; true; end
+  def to_s; ""; end
+end
+class EmptyProtocol
+  def empty?; "truthy"; end
+end
+class EmptyText
+  def to_s; ""; end
+end
+class OwnedCollection
+  def compact_blank; ["owned collection"]; end
+end
+ENV["ROUNDHOUSE_COMPACT_FEATURE"] = "  "
+ENV["ROUNDHOUSE_COMPACT_GLOBAL"] = "global-model"
+[nil, false, "", "  ", [], {}, OwnedBlank.new, EmptyProtocol.new].each do |value|
+  config = DefaultReader.new(value)
+  result = Article.configured_model_ids(config)
+  raise "blank retained #{value.inspect}: #{result.inspect}" unless result == ["known-model", "global-model"]
+  raise "opaque reader repeated" unless config.reads == 1
+end
+[0, true, "other-model", [nil], {"key" => nil}, OwnedPresent.new, EmptyText.new].each do |value|
+  config = DefaultReader.new(value)
+  result = Article.configured_model_ids(config)
+  raise "present lost #{value.inspect}: #{result.inspect}" unless result == ["known-model", "global-model", value]
+  raise "opaque reader repeated" unless config.reads == 1
+end
+raise "uniq lost" unless Article.configured_model_ids(DefaultReader.new("known-model")) == ["known-model", "global-model"]
+raise "unknown receiver captured" unless Article.unknown_collection(OwnedCollection.new) == ["owned collection"]
+raise "custom predicate lost" unless ActiveSupport.blank?(OwnedBlank.new) == true && ActiveSupport.blank?(OwnedPresent.new) == false
+raise "custom empty result not Boolean" unless ActiveSupport.blank?(EmptyProtocol.new) == true
+raise "empty to_s is not blank" unless ActiveSupport.blank?(EmptyText.new) == false
+puts "literal compact_blank OK"
+"#);
+    run.assert_passes();
+    let source = std::fs::read_to_string(run.emitted.join("app/models/article.rb")).unwrap();
+    assert!(source.contains("ActiveSupport.blank?(__cb)"), "{source}");
+    assert!(!source.contains("].compact_blank"), "{source}");
+    assert!(source.contains("value.compact_blank"), "{source}");
+    assert_eq!(run.stdout, "literal compact_blank OK\n");
+}
+
+#[test]
+fn application_array_compact_blank_overrides_keep_normal_dispatch() {
+    let run = emit_and_run::real_blog()
+        .write(
+            "app/models/array.rb",
+            r#"
+class Array
+  def compact_blank
+    ["owned Array"]
+  end
+end
+"#,
+        )
+        .edit(
+            "app/models/article.rb",
+            "class Article < ApplicationRecord",
+            r#"class Article < ApplicationRecord
+  def self.literal_compact
+    [nil, ""].compact_blank
+  end
+"#,
+        )
+        .run_ruby(
+            r#"
+raise "Array override replaced" unless Article.literal_compact == ["owned Array"]
+puts "Array override OK"
+"#,
+        );
+    run.assert_passes();
+    let source = std::fs::read_to_string(run.emitted.join("app/models/article.rb")).unwrap();
+    assert!(source.contains("[nil, \"\"].compact_blank"), "{source}");
+    assert!(!source.contains(".reject"), "{source}");
+}
