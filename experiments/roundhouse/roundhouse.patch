+            if matches!(method.as_str(), "where" | "not" | "find_by" | "find_by!") && args.iter().any(|a|
+                matches!(&*a.node, ExprNode::Hash { entries, .. } if entries.iter().any(|(_, v)| v.ty.as_ref().is_some_and(crate::emit::ruby::expr::is_date_range_type)))) {
