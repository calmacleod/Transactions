+        .write("app/services/custom_key_converter.rb", "class CustomKeyConverter\n def stringify_keys\n { \"custom\" => 17 }\n end\nend\n")
+        .run_ruby("raise 'Hash override was replaced' unless KeywordHashProbe.new.convert(query: 'x') == { owned: true }\nraise 'custom receiver was replaced' unless CustomKeyConverter.new.stringify_keys == { 'custom' => 17 }\n");
+    run.assert_passes();
