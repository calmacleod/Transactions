+                    ">>" | "<<" | "+" => args.len() == 1 && matches!(args[0].ty, Some(Ty::Int)),
+                    "-" => args.len() == 1 && args[0].ty.as_ref().is_some_and(|t| matches!(t, Ty::Date | Ty::Int)),
+                    "<" | "<=" | ">" | ">=" | "<=>" => args.len() == 1 && args[0].ty.as_ref().is_some_and(date),
+                    "==" | "!=" | "eql?" | "is_a?" | "kind_of?" | "instance_of?" => args.len() == 1,
+                    "advance" => args.len() <= 1 && args.iter().all(|a| matches!(&*a.node, ExprNode::Hash { entries, .. }
