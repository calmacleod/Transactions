+        .methods
+        .iter()
+        .find(|method| method.name.as_str() == "optional")
+        .unwrap();
+    assert!(
+        matches!(optional.body.ty.as_ref(), Some(Ty::Hash { key, value })
+        if matches!(&**key, Ty::Var { .. }) && matches!(&**value, Ty::Var { .. })),
+        "an ordinary empty default is not keyword-rest evidence: {:?}",
+        optional.body.ty
