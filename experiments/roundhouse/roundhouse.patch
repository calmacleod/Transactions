+                    // operations, including gradual SQL/request boundaries.
+                    "iso8601" => args.len() == 1 && matches!(args[0].ty, None | Some(Ty::Str | Ty::Untyped | Ty::Var { .. })),
+                    "strptime" => args.len() == 2 && matches!(args[0].ty, None | Some(Ty::Str | Ty::Untyped | Ty::Var { .. }))
