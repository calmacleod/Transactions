+end
+article = Article.create!(title: "Dated", body: "A sufficiently long body.", due_on: Date.new(2024, 1, 31))
+article = Article.find(article.id)
+article.update_from_article_params!(date_form({"body" => "Only the notes/body changed."}))
+raise "omitted date overwritten" unless article.due_on == Date.new(2024, 1, 31)
