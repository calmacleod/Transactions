+//! Narrow Array/permit-array evidence must remove native compact_blank sends.
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+#[test]
+fn request_arrays_and_permitted_array_fetches_execute_without_core_reopens() {
+    let run = emit_and_run::real_blog()
+        .edit("config/routes.rb", "Rails.application.routes.draw do", "Rails.application.routes.draw do\n  get \"/compact-probe\", to: \"compact_probe#index\"")
+        .write("app/controllers/compact_probe_controller.rb", r#"
+class CompactProbeController < ApplicationController
+  def index
+    head :ok
+  end
+
+  private
+
+  def wrapped_ids
+    Array(params[:transaction_ids]).compact_blank
+  end
+
+  def permitted_ids
+    bulk_params.to_h.fetch("transaction_ids", []).compact_blank
+  end
+
+  def bulk_params
+    params.require(:bulk).permit(:label, transaction_ids: [])
+  end
+
+  def fetch_defaults_stay_fresh
+    permitted = bulk_params
+    first = permitted.to_h.fetch("transaction_ids", [])
+    first << "added"
+    permitted.to_h.fetch("transaction_ids", [])
+  end
+
+  def custom_collection
+    CompactCollection.new.compact_blank
+  end
+end
+"#)
+        .write("app/controllers/shadowed_array_controller.rb", r#"
+class ShadowedArrayController < ApplicationController
+  def index
+    head :ok
+  end
+
+  private
+
+  def Array(value)
+    CompactCollection.new
+  end
+
+  def wrapped_ids
+    Array(params[:transaction_ids]).compact_blank
+  end
+end
+"#)
+        .write("app/models/compact_collection.rb", r#"
+class CompactCollection
+  def compact_blank
+    ["custom dispatch"]
+  end
+end
+"#)
+        .run_ruby(r#"
+require_relative "app/controllers/application_controller"
+require_relative "app/controllers/compact_probe_controller"
+require_relative "app/controllers/shadowed_array_controller"
+# A core reopen must never hide a surviving call in the emitted tree.
+class Array
+  undef_method :compact_blank if method_defined?(:compact_blank)
+end
+class Hash
+  undef_method :compact_blank if method_defined?(:compact_blank)
+end
+probe = CompactProbeController.new
+values = [nil, false, "", "  ", [], {}, 0, true, "12", {"key" => "value"}, ["nested"]]
+probe.params = {"transaction_ids" => values}
+expected = [0, true, "12", {"key" => "value"}, ["nested"]]
+raise probe.send(:wrapped_ids).inspect unless probe.send(:wrapped_ids) == expected
+raise "input mutated" unless values.length == 11
+probe.params = {"transaction_ids" => "12"}
+raise "scalar Array wrapping lost" unless probe.send(:wrapped_ids) == ["12"]
+probe.params = {}
+raise "nil Array wrapping lost" unless probe.send(:wrapped_ids) == []
+probe.params = {"transaction_ids" => {"key" => "value"}}
+raise "Hash Array wrapping lost" unless probe.send(:wrapped_ids) == [["key", "value"]]
+probe.params = {"bulk" => {"label" => "unused", "transaction_ids" => ["", " ", "12", "0"]}}
+raise probe.send(:permitted_ids).inspect unless probe.send(:permitted_ids) == ["12", "0"]
+probe.params = {"bulk" => {"label" => "unused"}}
+raise "missing permitted array changed" unless probe.send(:permitted_ids) == []
+raise "generic fetch default aliased the stored array" unless probe.send(:fetch_defaults_stay_fresh) == []
+raise "custom dispatch captured" unless probe.send(:custom_collection) == ["custom dispatch"]
+shadowed = ShadowedArrayController.new
+shadowed.params = {"transaction_ids" => ["ignored"]}
+raise "app Array override captured" unless shadowed.send(:wrapped_ids) == ["custom dispatch"]
+puts "request compact_blank OK"
+"#);
+    run.assert_passes();
+    let source = std::fs::read_to_string(
+        run.emitted
+            .join("app/controllers/compact_probe_controller.rb"),
+    )
+    .unwrap();
+    assert!(
+        !source.contains(".fetch(\"transaction_ids\", []).compact_blank"),
+        "{source}"
+    );
+    assert!(
+        !source.contains("Array(@params[\"transaction_ids\"]).compact_blank"),
+        "{source}"
+    );
+    assert!(source.contains("ActiveSupport.blank?(__cb)"), "{source}");
+    assert!(
+        source.contains("permitted.to_h.fetch(\"transaction_ids\", [])"),
+        "general fetch must retain default identity: {source}"
+    );
+    assert!(
+        source.contains("CompactCollection.new.compact_blank"),
+        "custom method must keep dispatch: {source}"
+    );
+}
diff --git a/tests/container_narrowing.rs b/tests/container_narrowing.rs
new file mode 100644
index 00000000..5ad4b5d6
--- /dev/null
+++ b/tests/container_narrowing.rs
@@ -0,0 +1,290 @@
+//! Core container tests preserve known element types and the recursive request
+//! value contract; an arbitrary untyped input must keep its gradual escape.
+
+use std::collections::HashMap;
+use std::path::PathBuf;
+
+use roundhouse::analyze::{BodyTyper, ClassInfo, Ctx};
+use roundhouse::expr::{Expr, ExprNode, Literal};
+use roundhouse::ident::{ClassId, Symbol, TyVar, VarId};
+use roundhouse::span::Span;
+use roundhouse::ty::Ty;
+
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+fn param_value() -> Ty {
+    Ty::Class {
+        id: ClassId(Symbol::from("Roundhouse::ParamValue")),
+        args: vec![],
+    }
+}
+
+fn narrowed(input: Ty, path: &[&str]) -> Ty {
+    let variable = || {
+        Expr::new(
+            Span::synthetic(),
+            ExprNode::Var {
+                id: VarId(0),
+                name: Symbol::from("value"),
+            },
+        )
+    };
+    let mut expression = Expr::new(
+        Span::synthetic(),
+        ExprNode::If {
+            cond: Expr::new(
+                Span::synthetic(),
+                ExprNode::Send {
+                    recv: Some(variable()),
+                    method: Symbol::from("is_a?"),
+                    args: vec![Expr::new(
+                        Span::synthetic(),
+                        ExprNode::Const {
+                            path: path.iter().map(|part| Symbol::from(*part)).collect(),
+                        },
+                    )],
+                    block: None,
+                    parenthesized: true,
+                },
+            ),
+            then_branch: variable(),
+            else_branch: Expr::new(
+                Span::synthetic(),
+                ExprNode::Lit {
+                    value: Literal::Nil,
+                },
+            ),
+        },
+    );
+    let classes: HashMap<ClassId, ClassInfo> = HashMap::new();
+    let mut context = Ctx::default();
+    context.local_bindings.insert(Symbol::from("value"), input);
+    BodyTyper::new(&classes).analyze_expr(&mut expression, &context);
+    let ExprNode::If { then_branch, .. } = &*expression.node else {
+        unreachable!()
+    };
+    then_branch.ty.clone().expect("typed true branch")
+}
+
+#[test]
+fn core_array_and_hash_tests_retain_concrete_and_recursive_members() {
+    let array = Ty::Array {
+        elem: Box::new(Ty::Str),
+    };
+    let hash = Ty::Hash {
+        key: Box::new(Ty::Str),
+        value: Box::new(Ty::Int),
+    };
+    assert_eq!(narrowed(array.clone(), &["Array"]), array);
+    assert_eq!(
+        narrowed(
+            Ty::Union {
+                variants: vec![array.clone(), Ty::Nil]
+            },
+            &["", "Array"]
+        ),
+        array
+    );
+    assert_eq!(narrowed(hash.clone(), &["Hash"]), hash);
+    assert_eq!(
+        narrowed(
+            Ty::Union {
+                variants: vec![hash.clone(), Ty::Str]
+            },
+            &["Hash"]
+        ),
+        hash
+    );
+    assert_eq!(
+        narrowed(param_value(), &["Array"]),
+        Ty::Array {
+            elem: Box::new(param_value())
+        }
+    );
+    assert_eq!(
+        narrowed(
+            Ty::Union {
+                variants: vec![param_value(), Ty::Nil]
+            },
+            &["Hash"]
+        ),
+        Ty::Hash {
+            key: Box::new(Ty::Str),
+            value: Box::new(param_value())
+        }
+    );
+    for fallback in [
+        Ty::Array {
+            elem: Box::new(Ty::Var { var: TyVar(0) }),
+        },
+        Ty::Hash {
+            key: Box::new(Ty::Var { var: TyVar(1) }),
+            value: Box::new(Ty::Var { var: TyVar(2) }),
+        },
+    ] {
+        let (class, expected) = if matches!(fallback, Ty::Array { .. }) {
+            (
+                "Array",
+                Ty::Array {
+                    elem: Box::new(param_value()),
+                },
+            )
+        } else {
+            (
+                "Hash",
+                Ty::Hash {
+                    key: Box::new(Ty::Str),
+                    value: Box::new(param_value()),
+                },
+            )
+        };
+        for variants in [
+            vec![param_value(), fallback.clone()],
+            vec![fallback, param_value()],
+        ] {
+            assert_eq!(narrowed(Ty::Union { variants }, &[class]), expected);
+        }
+    }
+}
+
+#[test]
+fn unknown_values_and_custom_container_names_do_not_gain_fake_member_types() {
+    let gradual_array = Ty::Array {
+        elem: Box::new(Ty::Untyped),
+    };
+    let gradual_hash = Ty::Hash {
+        key: Box::new(Ty::Untyped),
+        value: Box::new(Ty::Untyped),
+    };
+    assert_eq!(narrowed(Ty::Untyped, &["Array"]), gradual_array);
+    assert_eq!(narrowed(Ty::Untyped, &["Hash"]), gradual_hash);
+    let mixed = narrowed(
+        Ty::Union {
+            variants: vec![
+                Ty::Array {
+                    elem: Box::new(Ty::Str),
+                },
+                Ty::Untyped,
+            ],
+        },
+        &["Array"],
+    );
+    assert!(
+        format!("{mixed:?}").contains("Untyped"),
+        "unknown variant was discarded: {mixed:?}"
+    );
+    let recursive_and_gradual = narrowed(
+        Ty::Union {
+            variants: vec![param_value(), gradual_array],
+        },
+        &["Array"],
+    );
+    assert!(format!("{recursive_and_gradual:?}").contains("Untyped"));
+    assert_eq!(
+        narrowed(param_value(), &["Other", "Array"]),
+        Ty::Class {
+            id: ClassId(Symbol::from("Other::Array")),
+            args: vec![]
+        }
+    );
+    assert_eq!(
+        narrowed(param_value(), &["Other", "Hash"]),
+        Ty::Class {
+            id: ClassId(Symbol::from("Other::Hash")),
+            args: vec![]
+        }
+    );
+}
+
+#[test]
+fn actual_params_runtime_binds_recursive_array_items_without_open_members() {
+    let methods = roundhouse::runtime_src::parse_methods_with_rbs(
+        include_str!("../runtime/ruby/params.rb"),
+        include_str!("../runtime/ruby/params.rbs"),
+    )
+    .expect("Params runtime parses");
+    let array = methods
+        .iter()
+        .find(|method| method.name.as_str() == "array")
+        .unwrap();
+    let mut reads = 0;
+    fn visit(expr: &Expr, reads: &mut usize) {
+        if matches!(&*expr.node, ExprNode::Var { name, .. } if name.as_str() == "item") {
+            assert_eq!(
+                expr.ty,
+                Some(param_value()),
+                "item lost its recursive contract: {expr:?}"
+            );
+            *reads += 1;
+        }
+        expr.node.for_each_child(&mut |child| visit(child, reads));
+    }
+    visit(&array.body, &mut reads);
+    assert!(reads >= 4, "runtime item reads were not inspected");
+}
+
+#[test]
+fn arbitrary_runtime_array_items_remain_gradual_in_source_diagnostics() {
+    let ruby = "class Probe < ApplicationRecord\n def first_item(value)\n if value.is_a?(Array)\n value.first\n else\n nil\n end\n end\nend";
+    let rbs = "class Probe\n def first_item: (untyped value) -> untyped\nend";
+    let tree: HashMap<PathBuf, Vec<u8>> = [
+        ("db/schema.rb", "ActiveRecord::Schema.define do\n create_table :probes do |t|; t.string :name; end\nend"),
+        ("app/models/probe.rb", ruby),
+    ].into_iter().map(|(path, source)| (PathBuf::from(path), source.as_bytes().to_vec())).collect();
+    let mut app = roundhouse::ingest::ingest_app_from_tree(tree).unwrap();
+    // Exercise the actual runtime Ruby/RBS body typer, then the standard
+    // diagnostic walker. This does not synthesize any type annotations.
+    let methods = roundhouse::runtime_src::parse_methods_with_rbs(ruby, rbs).unwrap();
+    app.models[0].methods_mut().next().unwrap().body = methods[0].body.clone();
+    fn assert_first_is_gradual(expr: &Expr, found: &mut bool) {
+        if matches!(&*expr.node, ExprNode::Send { method, .. } if method.as_str() == "first") {
+            assert!(
+                format!("{:?}", expr.ty).contains("Untyped"),
+                "Array member became falsely concrete: {expr:?}"
+            );
+            *found = true;
+        }
+        expr.node
+            .for_each_child(&mut |child| assert_first_is_gradual(child, found));
+    }
+    let mut found = false;
+    assert_first_is_gradual(&methods[0].body, &mut found);
+    assert!(found, "Array member read was not inspected");
+    let diagnostics = roundhouse::analyze::diagnose(&app);
+    assert!(
+        diagnostics.iter().any(|diagnostic| matches!(
+            &diagnostic.kind,
+            roundhouse::diagnostic::DiagnosticKind::GradualUntyped { .. }
+        )),
+        "an arbitrary Array's member read must remain gradual: {diagnostics:?}"
+    );
+}
+
+#[test]
+fn emitted_recursive_params_accessors_preserve_filtering_and_fallbacks() {
+    let run = emit_and_run::real_blog()
+        .write("app/lib/recursive_params_probe.rb", r#"class RecursiveParamsProbe
+  def self.array(sub)
+    Params.array(sub, "ids")
+  end
+  def self.sub(params)
+    Params.sub(params, "resource")
+  end
+end
+"#)
+        .run_ruby(r#"
+input = {"ids" => ["", nil, ["nested"], {"nested" => "object"}, "17", 4, false]}
+raise "scalar filtering changed" unless RecursiveParamsProbe.array(input) == ["", "17", "4", "false"]
+raise "empty array changed" unless RecursiveParamsProbe.array({"ids" => []}) == []
+raise "missing fallback changed" unless RecursiveParamsProbe.array({}) == []
+raise "Hash passed array check" unless RecursiveParamsProbe.array({"ids" => {"nested" => "object"}}) == []
+raise "String passed array check" unless RecursiveParamsProbe.array({"ids" => "17"}) == []
+resource = {"ids" => ["17"], "nested" => {"name" => "kept"}}
+raise "recursive Hash changed" unless RecursiveParamsProbe.sub({"resource" => resource}) == resource
+raise "Array passed Hash check" unless RecursiveParamsProbe.sub({"resource" => resource.values}) == {}
+raise "Hash missing fallback changed" unless RecursiveParamsProbe.sub({}) == {}
+puts "recursive params: concrete containers, scalar filtering and fallbacks passed"
+"#);
+    run.assert_passes();
+}
