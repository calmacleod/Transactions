index 00000000..2ca333de
--- /dev/null
+++ b/runtime/spinel/date.rb
@@ -0,0 +1,321 @@
+# A date-only value for Spinel, which has no date package. The represented
+# calendar is Ruby Date's default Italian reform (1582-10-15). This bounded
+# surface accepts integer years 1..9999, ISO dates, and the two strptime
+# formats used by the emitted app. Other parser/calendar modes are refused.
+class Date
+  DAYNAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']
+  attr_reader :days, :year, :month, :day
+
+  def initialize(year, month = 1, day = 1)
+    raise ArgumentError, 'year outside supported Date range' unless year >= 1 && year <= 9999
+    raise ArgumentError, 'invalid date' unless month >= 1 && month <= 12 && day >= 1 && day <= Date.days_in_month(year, month)
+    raise ArgumentError, 'invalid date' if year == 1582 && month == 10 && day >= 5 && day <= 14
+    @year = year
+    @month = month
+    @day = day
+    # Julian day for the pre-reform branch; modern dates use the shared
+    # Gregorian conversion, with the same epoch-day origin on both sides.
+    if year < 1582 || (year == 1582 && (month < 10 || (month == 10 && day <= 4)))
+      a = (14 - month).div(12)
+      y = year + 4800 - a
+      m = month + 12 * a - 3
+      @days = day + (153 * m + 2).div(5) + 365 * y + y.div(4) - 32083 - 2440588
+    else
+      @days = ActiveSupport.civil_days(year, month, day)
+    end
+  end
+
+  def self.days_in_month(year, month)
+    return 30 if month == 4 || month == 6 || month == 9 || month == 11
+    return 31 unless month == 2
+    leap = year % 4 == 0 && (year < 1582 || year % 100 != 0 || year % 400 == 0)
+    leap ? 29 : 28
+  end
+
+  def self.current
+    from_time(ActiveSupport.now)
+  end
+
+  def self.today
+    from_time(Time.now)
+  end
+
+  def self.civil(year, month = 1, day = 1)
+    new(year, month, day)
+  end
+
+  def self.from_time(time)
+    new(time.year, time.mon, time.mday)
+  end
+
+  def self.iso8601(value)
+    # SQL results and request inputs cross a checked boundary. Never coerce
+    # another object to a String: Ruby Date rejects non-string ISO input.
+    raise TypeError, 'Date.iso8601 requires a String' unless value.is_a?(String)
+    match = /\A(\d{4})-(\d{2})-(\d{2})\z/.match(value)
+    raise ArgumentError, 'invalid date' unless match
+    new(match[1].to_i, match[2].to_i, match[3].to_i)
+  end
+
+  def self.strptime(value, pattern)
+    raise TypeError, 'Date.strptime requires a String' unless value.is_a?(String)
+    return iso8601(value) if pattern == '%Y-%m-%d'
+    return iso8601(value + '-01') if pattern == '%Y-%m' && /\A\d{4}-\d{2}\z/.match(value)
+    raise ArgumentError, 'unsupported date format'
+  end
+
+  def self.from_days(days)
+    jd = days + 2440588
+    if jd < 2299161
+      c = jd + 32082
+      d = (4 * c + 3).div(1461)
+      e = c - (1461 * d).div(4)
+      m = (5 * e + 2).div(153)
+      new(d - 4800 + m.div(10), m + 3 - 12 * m.div(10), e - (153 * m + 2).div(5) + 1)
+    else
+      a = jd + 32044
+      b = (4 * a + 3).div(146097)
+      c = a - (146097 * b).div(4)
+      d = (4 * c + 3).div(1461)
+      e = c - (1461 * d).div(4)
+      m = (5 * e + 2).div(153)
+      new(100 * b + d - 4800 + m.div(10), m + 3 - 12 * m.div(10), e - (153 * m + 2).div(5) + 1)
+    end
+  end
+
+  def to_time
+    # Date#to_time uses local midnight, not UTC midnight or the absolute
+    # Julian day interpreted through a Gregorian Time calendar.
+    Time.local(@year, @month, @day)
+  end
+
+  def mon
+    @month
+  end
+
+  def mday
+    @day
+  end
+
+  def wday
+    (@days + 4) % 7
+  end
+
+  def yday
+    @days - Date.new(@year, 1, 1).days + 1
+  end
+
+  def strftime(pattern)
+    # Time formats the civil components; Date supplies calendar weekdays
+    # itself so pre-reform dates do not accidentally use Gregorian ones.
+    # Clock/zone and ISO-week formats are outside this bounded surface.
+    result = +''
+    i = 0
+    while i < pattern.length
+      if pattern[i] != '%'
+        result = result + pattern[i]
+        i += 1
+      else
+        start = i
+        i += 1
+        raise ArgumentError, 'invalid date format' if i >= pattern.length
+        while i < pattern.length && /[-_0^#0-9]/.match(pattern[i])
+          i += 1
+        end
+        raise ArgumentError, 'invalid date format' if i >= pattern.length
+        token = pattern[i]
+        # Width/flagged weekday and ordinal-day formats would otherwise
+        # use Time's Gregorian calendar for a Julian Date. Refuse them.
+        if 'Aajwu'.include?(token) && i != start + 1
+          raise ArgumentError, 'unsupported date format'
+        end
+        # Spinel's Time formatter defaults field-width padding to zero
+        # for names/compound formats, unlike Ruby Date's spaces. Admit
+        # these directives only without modifiers rather than render
+        # silently different month names, dates, whitespace or percent.
+        if 'bBhFDxnte%'.include?(token) && i != start + 1
+          raise ArgumentError, 'unsupported date format'
+        end
+        if token == 'A'
+          result = result + DAYNAMES[wday]
+        elsif token == 'a'
+          result = result + DAYNAMES[wday][0, 3]
+        elsif token == 'w'
+          result = result + wday.to_s
+        elsif token == 'u'
+          result = result + (wday == 0 ? 7 : wday).to_s
+        elsif token == 'j'
+          result = result + yday.to_s.rjust(3, '0')
+        elsif 'YCymbBhdeFDxnt%'.include?(token)
+          result = result + to_time.strftime(pattern[start, i - start + 1])
+        else
+          raise ArgumentError, 'unsupported date format'
+        end
+        i += 1
+      end
+    end
+    result
+  end
+
+  def iso8601
+    @year.to_s.rjust(4, '0') + '-' + @month.to_s.rjust(2, '0') + '-' + @day.to_s.rjust(2, '0')
+  end
+
+  def to_s
+    iso8601
+  end
+
+  def xmlschema
+    iso8601
+  end
+
+  def to_date
+    self
+  end
+
+  def leap?
+    Date.days_in_month(@year, 2) == 29
+  end
+
+  def monday?; wday == 1; end
+  def tuesday?; wday == 2; end
+  def wednesday?; wday == 3; end
+  def thursday?; wday == 4; end
+  def friday?; wday == 5; end
+  def saturday?; wday == 6; end
+  def sunday?; wday == 0; end
+
+  def beginning_of_month
+    Date.new(@year, @month, 1)
+  end
+
+  def end_of_month
+    Date.new(@year, @month, Date.days_in_month(@year, @month))
+  end
+
+  def beginning_of_week
+    Date.from_days(@days - (wday + 6) % 7)
+  end
+
+  def end_of_week
+    beginning_of_week + 6
+  end
+
+  def >>(months)
+    total = @year * 12 + @month - 1 + months
+    y = total.div(12)
+    m = total % 12 + 1
+    d = [@day, Date.days_in_month(y, m)].min
+    d = 4 if y == 1582 && m == 10 && d >= 5 && d <= 14
+    Date.new(y, m, d)
+  end
+
+  def <<(months)
+    self >> -months
+  end
+
+  def advance(years: 0, months: 0, weeks: 0, days: 0)
+    ((self >> (years * 12)) >> months) + weeks * 7 + days
+  end
+
+  def next_month(amount = 1)
+    self >> amount
+  end
+
+  def prev_month(amount = 1)
+    self << amount
+  end
+
+  def +(amount)
+    Date.from_days(@days + amount)
+  end
+
+  def -(other)
+    if other.is_a?(Date)
+      Rational(@days - other.days, 1)
+    else
+      Date.from_days(@days - other)
+    end
+  end
+
+  def <=>(other)
+    @days <=> other.days
+  end
+
+  def ==(other)
+    other.is_a?(Date) && @days == other.days
+  end
+
+  def eql?(other)
+    self == other
+  end
+
+  def hash
+    @days.hash
+  end
+
+  def <(other)
+    @days < other.days
+  end
+
+  def <=(other)
+    @days <= other.days
+  end
+
+  def >(other)
+    @days > other.days
+  end
+
+  def >=(other)
+    @days >= other.days
+  end
+end
+
+# Representation of Range[Date] on Spinel. Bounds remain Date values;
+# neither open ends nor exclusive ends narrow a Date into an integer.
+class DateRange
+  def initialize(first, last, exclusive = false)
+    @first = first
+    @last = last
+    @exclusive = exclusive
+  end
+
+  def begin
+    @first
+  end
+
+  def end
+    @last
+  end
+
+  def exclude_end?
+    @exclusive
+  end
+
+  def cover?(date)
+    (@first.nil? || date >= @first) && (@last.nil? || (@exclusive ? date < @last : date <= @last))
+  end
+end
+
+module ActiveSupport
+  def self.to_date(time)
+    Date.from_time(time)
+  end
+
+  def self.parse_db_date(value)
+    return nil if value.nil? || value.empty?
+    Date.iso8601(value)
+  end
+
+  def self.format_db_date(value)
+    return nil if value.nil?
+    if value.is_a?(Date)
+      value.iso8601
+    elsif value.is_a?(String)
+      Date.iso8601(value).iso8601
+    else
+      raise TypeError, 'expected Date or ISO date text'
+    end
+  end
+
+end
