index 00000000..989e73a5
--- /dev/null
+++ b/src/lower/decimal.rs
@@ -0,0 +1,19 @@
+//! BigDecimal util conversions without reopening native builtin types.
+use crate::app::App;
+use crate::expr::{Expr, ExprNode};
+use crate::ident::{ClassId, Symbol};
+use crate::ty::Ty;
+
+pub fn apply_decimal_grounding(app: &mut App) {
+    super::for_each_hook_body(app, &mut rewrite);
+}
+fn rewrite(e: &mut Expr) {
+    e.node.for_each_child_mut(&mut rewrite);
+    let ExprNode::Send { recv: Some(r), method, args, block: None, .. } = &*e.node else { return; };
+    if method.as_str() != "to_d" || !args.is_empty() { return; }
+    let text = Expr::new(e.span, ExprNode::Send {
+        recv: Some(r.clone()), method: Symbol::from("to_s"), args: vec![], block: None, parenthesized: false,
+    });
+    *e.node = ExprNode::Send { recv: None, method: Symbol::from("BigDecimal"), args: vec![text], block: None, parenthesized: true };
+    e.ty = Some(Ty::Class { id: ClassId(Symbol::from("BigDecimal")), args: vec![] });
+}
diff --git a/tests/params_schema_coercion.rs b/tests/params_schema_coercion.rs
new file mode 100644
index 00000000..7285be3e
--- /dev/null
+++ b/tests/params_schema_coercion.rs
@@ -0,0 +1,69 @@
+//! Form strings must reach numeric and boolean setters as values, not C pointers.
+use std::{collections::HashMap, path::PathBuf};
+
+#[test]
+fn typed_create_and_update_cast_scalar_column_values() {
+    let files = [
+        ("db/schema.rb", "ActiveRecord::Schema.define do\n create_table :users do |t|\n t.integer :hour, null: false\n t.float :ratio\n t.boolean :enabled, null: false\n t.string :name\n end\nend"),
+        ("app/models/user.rb", "class User < ApplicationRecord\nend"),
+        ("app/controllers/users_controller.rb", "class UsersController < ApplicationController\n def create\n User.create!(user_params)\n end\n def update\n User.find(params[:id]).update!(user_params)\n end\n private\n def user_params\n params.require(:user).permit(:hour, :ratio, :enabled, :name)\n end\nend"),
+    ];
+    let tree: HashMap<PathBuf, Vec<u8>> = files.into_iter().map(|(p,s)| (p.into(), s.as_bytes().to_vec())).collect();
+    let mut app = roundhouse::ingest::ingest_app_from_tree(tree).unwrap();
+    roundhouse::session::analyze_and_lower(&mut app);
+    let emitted = roundhouse::emit::ruby::emit_lowered_models(&app);
+    let source = &emitted.iter().find(|file| file.path.ends_with("app/models/user.rb")).unwrap().content;
+    for method in ["from_params", "update_from_user_params!"] {
+        let section = source.split(&format!("def {}", if method == "from_params" { "self.from_params" } else { method })).nth(1).unwrap_or_else(|| panic!("missing {method}: {source}"));
+        // Both helpers must cast at assignment; checking the emitted method
+        // catches the String-to-Integer path that the native app corrupted.
+        assert!(section.contains("p.hour.to_i"), "{method}: {section}");
+        assert!(section.contains("p.ratio.to_f"), "{method}: {section}");
+        assert!(section.contains("include?") && section.contains("p.enabled"), "{method}: {section}");
+    }
+}
+
+#[test]
+fn contextual_defaults_and_instance_keywords_keep_named_binding() {
+    let files = [
+        ("db/schema.rb", "ActiveRecord::Schema.define do\n create_table :users do |t|\n t.string :name\n end\nend"),
+        ("app/models/user.rb", "class User < ApplicationRecord\nend"),
+        ("app/controllers/users_controller.rb", "class UsersController < ApplicationController\n def show\n Report.new(user: User.find(params[:id])).call(schema: nil)\n end\nend"),
+    ];
+    let tree: HashMap<PathBuf, Vec<u8>> = files.into_iter().map(|(p,s)| (p.into(), s.as_bytes().to_vec())).collect();
+    let mut app = roundhouse::ingest::ingest_app_from_tree(tree).unwrap();
+    app.library_classes.extend(roundhouse::ingest::ingest_library_classes(b"class Report\n def initialize(model: Current.user, user: nil)\n @model=model\n @user=user\n end\n def call(start_date: Time.now, schema: nil)\n start_date\n end\nend", "app/services/report.rb").unwrap());
+    roundhouse::session::analyze_and_lower(&mut app);
+    let mut files = roundhouse::emit::ruby::emit_spinel(&app);
+    files.extend(roundhouse::emit::ruby::emit_library(&app));
+    let source = files.iter().map(|file| file.content.as_str()).collect::<Vec<_>>().join("\n");
+    assert!(source.contains("def initialize(model:"), "context default must stay in callee: {}", files.iter().filter(|f| f.path.to_string_lossy().contains("report") || f.path.to_string_lossy().contains("users_controller")).map(|f| f.content.as_str()).collect::<Vec<_>>().join("\n"));
+    assert!(source.contains("def call(start_date:"), "instance method keeps named binding");
+    assert!(source.contains("Report.new(user:"), "caller can omit the context default");
+    assert!(source.contains(".call(schema:"), "schema must not bind to start_date");
+}
+
+#[test]
+fn collection_route_precedes_standard_dynamic_member() {
+    let mut tree = HashMap::new();
+    tree.insert(PathBuf::from("config/routes.rb"), b"Rails.application.routes.draw do\n resources :users, only: %i[index update] do\n patch :bulk_update, on: :collection\n end\nend".to_vec());
+    let app = roundhouse::ingest::ingest_app_from_tree(tree).unwrap();
+    let routes = roundhouse::lower::routes::flatten_routes(&app);
+    let collection = routes.iter().position(|r| r.path == "/users/bulk_update").unwrap();
+    let member = routes.iter().position(|r| r.path == "/users/:id").unwrap();
+    assert!(collection < member, "a collection action must not bind as an id");
+}
+
+#[test]
+fn nested_array_rows_use_scalar_permit_on_emitted_hashes() {
+    let files = [
+        ("app/controllers/imports_controller.rb", "class ImportsController < ApplicationController\n def create\n render json: permitted_rows\n end\n private\n def permitted_rows\n params.require(:import).fetch(\"rows\", []).map { |row| row.permit(:id, :included) }\n end\nend"),
+    ];
+    let tree: HashMap<PathBuf, Vec<u8>> = files.into_iter().map(|(p,s)| (p.into(), s.as_bytes().to_vec())).collect();
+    let mut app = roundhouse::ingest::ingest_app_from_tree(tree).unwrap();
+    roundhouse::session::analyze_and_lower(&mut app);
+    let files = roundhouse::emit::ruby::emit_spinel(&app);
+    let source = &files.iter().find(|f| f.path.ends_with("app/controllers/imports_controller.rb")).unwrap().content;
+    assert!(source.contains("Params.permit_scalars(row,"), "{source}");
+    assert!(!source.contains("row.permit("), "{source}");
+}
