diff --git a/tests/spinel_date_emitted_probe.rb b/tests/spinel_date_emitted_probe.rb
new file mode 100644
index 00000000..1d0fb45b
--- /dev/null
+++ b/tests/spinel_date_emitted_probe.rb
@@ -0,0 +1,38 @@
+# This input runs against either emitted backend's already-booted SQLite
+# app. The native Spinel harness can load it after boot/config/schema.
+CalendarEntry.create!(due_on: Date.new(2024, 1, 30))
+CalendarEntry.create!(due_on: Date.new(2024, 1, 31))
+CalendarEntry.create!(due_on: Date.new(2024, 2, 29))
+CalendarEntry.create!(due_on: Date.new(2024, 3, 31))
+probe = CalendarEntry.new
+raise 'inclusive literal SQL' unless probe.literal_window.count == 3
+raise 'open literal SQL' unless probe.open_window.count == 3
+raise 'dynamic exclusive SQL' unless probe.dynamic_window.count == 2
+raise 'dynamic beginless SQL' unless probe.beginless_window.count == 4
+raise 'interval bounds' unless probe.range_value.begin.iso8601 == '2024-01-31' && probe.range_value.end.iso8601 == '2024-03-31' && probe.range_value.exclude_end?
+raise 'typed first bound' unless probe.first_bound.iso8601 == '2024-01-31'
+raise 'typed last bound' unless probe.last_bound.iso8601 == '2024-03-31'
+raise 'checked parser' unless probe.parsed_date('2024-01-31').iso8601 == '2024-01-31'
+raise 'integer day addition' unless probe.next_day.iso8601 == '2024-02-01'
+raise 'integer day subtraction' unless probe.previous_day.iso8601 == '2024-01-30'
+raise 'date comparisons' unless probe.ordered
+raise 'calendar clamp' unless probe.shifted.iso8601 == '2024-02-29'
+raise 'times map date amount' unless probe.mapped_dates.map(&:iso8601) == ['2024-01-31', '2024-02-07', '2024-02-14']
+raise 'zero times map' unless probe.mapped_dates(count: 0).empty?
+raise 'negative times map' unless probe.mapped_dates(count: -1).empty?
+raise 'collect indices' unless probe.collected_indices(3) == [0, 1, 2]
+raise 'negative collect indices' unless probe.collected_indices(-1).empty?
+raise 'times block integer result' unless probe.times_block_result == 3
+raise 'duration day window' unless probe.duration_window.begin.is_a?(Date) && probe.duration_window.end.is_a?(Date)
+raise 'duration month window' unless probe.duration_month_window.begin.is_a?(Date) && probe.duration_month_window.begin.day == 1
+raise 'Rational delta' unless probe.date_delta == 60
+raise 'Time conversion' unless probe.from_time.iso8601 == '2024-02-29'
+raise 'Date constants' unless probe.day_names[0] == 'Sunday'
+raise 'shared current/calendar grounding' unless probe.calendar.is_a?(Date)
+entry = CalendarEntry.find_by(due_on: Date.new(2024, 2, 29))
+raise 'hydration' unless entry.due_on.iso8601 == '2024-02-29'
+entry.update!(due_on: Date.new(2024, 3, 1))
+raise 'date reload' unless entry.reload.due_on.iso8601 == '2024-03-01'
+entry.update!(due_on: nil)
+raise 'nullable hydration' unless entry.reload.due_on.nil?
+puts 'PASS emitted Date and interval SQL'
diff --git a/tests/spinel_date_runtime.rb b/tests/spinel_date_runtime.rb
new file mode 100644
index 00000000..70cb5ab0
--- /dev/null
+++ b/tests/spinel_date_runtime.rb
@@ -0,0 +1,63 @@
+# Executable native compiler input. Keep the only framework dependency
+# here at the actual civil-calendar implementation used by Date.
+require_relative '../runtime/ruby/active_support_ext'
+require_relative '../runtime/spinel/active_support_time_parsing'
+require_relative '../runtime/spinel/date'
+
+january = Date.iso8601('2024-01-31')
+def parse_iso_boundary(value)
+  Date.iso8601(value)
+end
+def parse_month_boundary(value)
+  Date.strptime(value, '%Y-%m')
+end
+raise 'checked ISO boundary' unless parse_iso_boundary('2024-01-31').iso8601 == '2024-01-31'
+[123, nil, january].each do |wrong|
+  begin
+    parse_iso_boundary(wrong)
+    raise 'ISO parser coerced non-string'
+  rescue TypeError
+  end
+  begin
+    parse_month_boundary(wrong)
+    raise 'month parser coerced non-string'
+  rescue TypeError
+  end
+end
+raise 'month clamp' unless (january >> 1).iso8601 == '2024-02-29'
+raise 'one-shot month shift' unless (january >> 2).iso8601 == '2024-03-31'
+raise 'combined advance ordering' unless Date.iso8601('2024-02-29').advance(years: 1, months: 1).iso8601 == '2025-03-28'
+raise 'week boundary' unless Date.iso8601('2026-10-01').beginning_of_week.iso8601 == '2026-09-28'
+raise 'month boundary' unless Date.iso8601('2026-10-01').end_of_month.iso8601 == '2026-10-31'
+raise 'calendar reform' unless (Date.new(1582, 10, 4) + 1).iso8601 == '1582-10-15'
+raise 'year-one weekday' unless Date.new(1, 1, 1).wday == 6
+raise 'subtraction type' unless (Date.iso8601('2026-10-01') - Date.iso8601('2026-09-29')).is_a?(Rational)
+raise 'day subtraction' unless (Date.iso8601('2026-10-01') - Date.iso8601('2026-09-29')).to_i == 2
+raise 'date keys' unless { january => 123 }.fetch(Date.iso8601('2024-01-31'), 0) == 123
+raise 'date grouping' unless [january, Date.iso8601('2024-01-31')].group_by { |d| d }.size == 1
+raise 'date hydration' unless ActiveSupport.parse_db_date('2026-10-01').iso8601 == '2026-10-01'
+raise 'canonical writer' unless ActiveSupport.format_db_date('2026-10-01') == '2026-10-01'
+raise 'month parser' unless Date.strptime('2026-10', '%Y-%m').iso8601 == '2026-10-01'
+raise 'formatting' unless january.strftime('%b %-d, %Y') == 'Jan 31, 2024'
+raise 'space padded day' unless Date.new(2024, 1, 1).strftime('%e') == ' 1'
+raise 'Julian weekday formatting' unless Date.new(1, 1, 1).strftime('%A %a %j %w %u') == 'Saturday Sat 001 6 6'
+['%c', '%+', '%Ec', '%Od', '%_A', '%3j', '%V', '%z', '%H', '%10b', '%10B', '%10x', '%20F', '%10D', '%10n', '%10%', '%5e'].each do |pattern|
+  begin
+    january.strftime(pattern)
+    raise 'unsupported formatter silently rendered'
+  rescue ArgumentError
+  end
+end
+range = DateRange.new(Date.iso8601('2026-10-01'), Date.iso8601('2026-10-31'))
+raise 'inclusive end' unless range.cover?(Date.iso8601('2026-10-31'))
+raise 'exclusive end' if DateRange.new(range.begin, range.end, true).cover?(range.end)
+raise 'open first' unless DateRange.new(nil, range.end).cover?(range.begin)
+raise 'open last' unless DateRange.new(range.begin, nil).cover?(range.end)
+['2026-02-29', '2026-10-01 trailing', '2026-10-01T00:00:00'].each do |value|
+  begin
+    ActiveSupport.parse_db_date(value)
+    raise 'invalid storage accepted'
+  rescue ArgumentError
+  end
+end
+puts 'PASS Spinel date runtime'
diff --git a/tests/spinel_request_params.rs b/tests/spinel_request_params.rs
new file mode 100644
index 00000000..148a665d
--- /dev/null
+++ b/tests/spinel_request_params.rs
@@ -0,0 +1,58 @@
+//! The native request scaffold reads JSON from its raw body, rather
+//! than Tep's flat String fields, without discarding typed values.
+
+use std::path::Path;
+use std::process::Command;
+
+#[test]
+fn json_request_params_preserve_values_and_merge_precedence() {
+    let root = Path::new(env!("CARGO_MANIFEST_DIR"));
+    let out = Command::new("ruby")
+        .arg("-e")
+        .arg(r##"
+require "json"
+load File.join(ARGV[0], "runtime/spinel/param_builder.rb")
+path = File.join(ARGV[0], "runtime/spinel/scaffold/main.rb")
+# Load the real scaffold's method bodies without booting an app/server.
+source = File.read(path).split("# Auto-run only when invoked as a script", 2).first
+source = source.sub('require_relative "boot"', '')
+eval(source, TOPLEVEL_BINDING, path)
+
+Request = Struct.new(:raw_query, :raw_body, :body_fields, :kind) do
+  def form?; kind == :form; end
+  def json?; kind == :json; end
+  def multipart?; kind == :multipart; end
+end
+body = {
+  "transaction_ids" => [1, 2],
+  "subcategory_ids" => [],
+  "rows" => [{"description" => "coffee", "amount" => 3.25, "selected" => true}],
+  "settings" => {"enabled" => false, "category_id" => nil},
+  "id" => 1,
+  "query_wins" => "body"
+}
+# A stale flattened representation must never replace the raw JSON.
+req = Request.new("query_wins=query&id=2", JSON.generate(body), {"id" => "wrong"}, :json)
+params = Main.request_params(req, {"id" => "3"})
+expected = body.merge("query_wins" => "query", "id" => "3")
+raise "JSON values changed: #{params.inspect}" unless params == expected
+raise "malformed JSON accepted" unless Main.request_params(Request.new("", "{bad", {}, :json), {}).nil?
+raise "empty body changed" unless Main.request_params(Request.new("q=1", "", {}, :json), {}) == {"q" => "1"}
+raise "invalid query accepted" unless Main.request_params(Request.new("q=%ZZ", "{}", {}, :json), {}).nil?
+
+form = Request.new("", "ids%5B%5D=1&ids%5B%5D=2", {}, :form)
+raise "form arrays changed" unless Main.request_params(form, {}) == {"ids" => ["1", "2"]}
+multipart = Request.new("", "", {"item[name]" => "coffee"}, :multipart)
+raise "multipart nesting changed" unless Main.request_params(multipart, {}) == {"item" => {"name" => "coffee"}}
+puts "ALL OK"
+"##)
+        .arg(root)
+        .output()
+        .expect("ruby is on PATH");
+    assert!(
+        out.status.success() && String::from_utf8_lossy(&out.stdout).contains("ALL OK"),
+        "request params failed\n=== stdout ===\n{}\n=== stderr ===\n{}",
+        String::from_utf8_lossy(&out.stdout),
+        String::from_utf8_lossy(&out.stderr),
+    );
+}
diff --git a/tests/string_truncate_lowering.rs b/tests/string_truncate_lowering.rs
new file mode 100644
index 00000000..f1c4a3bb
--- /dev/null
+++ b/tests/string_truncate_lowering.rs
@@ -0,0 +1,148 @@
+//! String truncation uses the shared helper without losing argument order
+//! or replacing a method owned by an application class.
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+use roundhouse::diagnostic::Severity;
+use roundhouse::ingest::ingest_app_from_tree;
+
+#[test]
+fn emitted_string_truncate_preserves_the_app_call_and_ruby_value_semantics() {
+    let run = emit_and_run::real_blog()
+        .edit(
+            "app/models/article.rb",
+            "class Article < ApplicationRecord",
+            r#"class Article < ApplicationRecord
+  SHORT_TITLE = "short".freeze
+  def self.chat_title
+    last_message = Article.last
+    (last_message && last_message.body).to_s.truncate(160)
+  end
+
+  def self.short_title
+    SHORT_TITLE.truncate(160)
+  end
+
+  def self.custom_omission
+    "abcdefgh".truncate(5, omission: "~")
+  end
+
+  def self.ordered_truncation
+    source_text.truncate(truncate_limit, omission: omission_text)
+  end
+
+  def self.source_text
+    @trace = "receiver;"
+    "abcdefgh"
+  end
+
+  def self.truncate_limit
+    @trace << "length;"
+    5
+  end
+
+  def self.omission_text
+    @trace << "omission;"
+    "~"
+  end
+
+  def self.trace
+    @trace
+  end
+"#,
+        )
+        .run_ruby(
+            r#"
+raise "nil message" unless Article.chat_title == ""
+body = "x" * 200
+Article.create!(title: "A message", body: body)
+raise "app limit" unless Article.chat_title == "x" * 157 + "..."
+raise "custom omission" unless Article.custom_omission == "abcd~"
+raise "ordered value" unless Article.ordered_truncation == "abcd~"
+raise "argument evaluation order/count" unless Article.trace == "receiver;length;omission;"
+short = Article.short_title
+raise "short result identity" if short.equal?(Article::SHORT_TITLE)
+short << " changed"
+raise "short result aliases its source" unless Article.short_title == "short"
+puts "String truncate: app call, omission, argument order, independent result passed"
+"#,
+        );
+    run.assert_passes();
+    let emitted = std::fs::read_to_string(run.emitted.join("app/models/article.rb")).unwrap();
+    assert!(emitted.contains("ActionView::ViewHelpers.truncate((last_message && last_message.body).to_s, length: 160)"), "{emitted}");
+    assert!(!emitted.contains(".to_s.truncate(160)"), "{emitted}");
+}
+
+#[test]
+fn custom_objects_and_numeric_truncate_keep_their_own_dispatch() {
+    let run = emit_and_run::real_blog()
+        .write("app/services/custom_truncator.rb", "class CustomTruncator\n  def truncate(length)\n    \"custom\"\n  end\nend\n")
+        .edit("app/models/article.rb", "class Article < ApplicationRecord", r#"class Article < ApplicationRecord
+  def self.custom_truncation
+    CustomTruncator.new.truncate(7)
+  end
+
+  def self.numeric_truncation
+    13.truncate(-1)
+  end
+"#)
+        .run_ruby("raise 'custom dispatch' unless Article.custom_truncation == 'custom'\nraise 'numeric dispatch' unless Article.numeric_truncation == 10\n");
+    run.assert_passes();
+    let emitted = std::fs::read_to_string(run.emitted.join("app/models/article.rb")).unwrap();
+    assert!(
+        emitted.contains("CustomTruncator.new.truncate(7)"),
+        "{emitted}"
+    );
+    assert!(!emitted.contains("ViewHelpers.truncate"), "{emitted}");
+}
+
+fn app_with_probe(extra: &str, call: &str) -> roundhouse::app::App {
+    let source =
+        format!("{extra}\nclass TruncateProbe\n  def self.value\n    {call}\n  end\nend\n");
+    ingest_app_from_tree(
+        [("app/services/truncate_probe.rb".into(), source.into_bytes())]
+            .into_iter()
+            .collect(),
+    )
+    .unwrap()
+}
+
+#[test]
+fn reopened_string_truncate_is_never_replaced_by_the_framework_helper() {
+    for reopen in [
+        "class String\n  def truncate(length)\n    \"owned\"\n  end\nend",
+        "class String\n  def +(other)\n    \"owned\"\n  end\nend",
+        "module TruncateOverride\n def truncate(length)\n  \"owned\"\n end\nend\nclass String\n prepend TruncateOverride\nend",
+    ] {
+        let mut app = app_with_probe(reopen, "\"abcdefgh\".truncate(3)");
+        roundhouse::session::analyze_and_lower(&mut app);
+        let emitted = roundhouse::emit::ruby::emit_library(&app)
+            .into_iter()
+            .map(|file| file.content)
+            .collect::<Vec<_>>()
+            .join("\n");
+        assert!(emitted.contains("\"abcdefgh\".truncate(3)"), "{emitted}");
+        assert!(!emitted.contains("ViewHelpers.truncate"), "{emitted}");
+    }
+}
+
+#[test]
+fn unsupported_string_truncation_options_remain_explicit_gaps() {
+    for call in [
+        "\"abcdef\".truncate",
+        "\"abcdef\".truncate(3, separator: \" \" )",
+        "\"abcdef\".truncate(3.5)",
+        "\"abcdef\".truncate(3) { \"ignored\" }",
+    ] {
+        let mut app = app_with_probe("", call);
+        let diagnostics = roundhouse::session::analyze_and_lower(&mut app);
+        assert!(
+            diagnostics
+                .iter()
+                .any(|diagnostic| diagnostic.severity == Severity::Error
+                    && diagnostic.message.contains("String#truncate")
+                    && !diagnostic.span.is_synthetic()),
+            "{call}: {diagnostics:?}"
+        );
+    }
+}
