+//! Collection signatures are claims about executable emitted Ruby.
+
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+#[test]
+fn tuple_elements_destructure_only_for_multiple_block_parameters() {
+    emit_and_run::real_blog()
+        .write("app/models/collection_probe.rb", r#"
+class CollectionProbe
+  def self.grouped_labels
+    ["one", "two", "three"].group_by { |name| name[0].to_s }
+      .sort_by { |letter, names| letter }
+      .map { |letter, names| letter.upcase + ":" + names.length.to_s }
+  end
+
+  def self.whole_pairs
+    { "one" => [1, 2], "two" => [3] }.to_a.map { |pair| pair[0].to_s.upcase }
+  end
+
+  def self.pairs_with_index
+    { "one" => [1, 2], "two" => [3] }.to_a.map.with_index do |pair, index|
+      pair[0].to_s.upcase + ":" + index.to_s
+    end
+  end
+
+  def self.enumerator_indexes
+    ["one", "two"].each_with_index.map { |name, index| name.upcase + ":" + index.to_s }
+  end
+
+  def self.enumerator_single_element
+    ["one", "two"].each_with_index.collect { |name| name.upcase }
+  end
+
+  def self.each_with_index_receiver
+    ["one", "two"].each_with_index { |name, index| name.upcase + index.to_s }
+  end
+
+  def self.extra_parameter
+    { "one" => [1, 2] }.to_a.map { |name, values, missing| name.upcase + values.length.to_s + missing.to_s }
+  end
+end
+"#)
+        .run_ruby(r#"
+raise CollectionProbe.grouped_labels.inspect unless CollectionProbe.grouped_labels == ["O:1", "T:2"]
+raise CollectionProbe.whole_pairs.inspect unless CollectionProbe.whole_pairs == ["ONE", "TWO"]
+raise CollectionProbe.pairs_with_index.inspect unless CollectionProbe.pairs_with_index == ["ONE:0", "TWO:1"]
+raise CollectionProbe.enumerator_indexes.inspect unless CollectionProbe.enumerator_indexes == ["ONE:0", "TWO:1"]
+raise CollectionProbe.enumerator_single_element.inspect unless CollectionProbe.enumerator_single_element == ["ONE", "TWO"]
+raise CollectionProbe.each_with_index_receiver.inspect unless CollectionProbe.each_with_index_receiver == ["one", "two"]
+raise CollectionProbe.extra_parameter.inspect unless CollectionProbe.extra_parameter == ["ONE2"]
+puts "tuple block binding OK"
+"#)
+        .assert_passes();
+}
+
+#[test]
+fn integer_range_map_and_array_fetch_run() {
+    emit_and_run::real_blog()
+        .write(
+            "app/models/collection_probe.rb",
+            r#"
+class CollectionProbe
+  def self.hours
+    (0..2).map { |hour| hour.to_s + ":00" }
+  end
+
+  def self.names
+    ["Sunday", "Monday"]
+  end
+
+  def self.day
+    names.fetch(1).upcase
+  end
+
+  def self.default_day
+    names.fetch(7, "Unknown").upcase
+  end
+
+  def self.fallback
+    names.fetch(7) { |index| index.to_s }
+  end
+
+  def self.nil_default
+    names.fetch(7, nil)
+  end
+end
+"#,
+        )
+        .run_ruby(
+            r#"
+raise CollectionProbe.hours.inspect unless CollectionProbe.hours == ["0:00", "1:00", "2:00"]
+raise CollectionProbe.day.inspect unless CollectionProbe.day == "MONDAY"
+raise CollectionProbe.default_day.inspect unless CollectionProbe.default_day == "UNKNOWN"
+raise CollectionProbe.fallback.inspect unless CollectionProbe.fallback == "7"
+raise "nil default lost" unless CollectionProbe.nil_default.nil?
+begin
+  CollectionProbe.names.fetch(7)
+  raise "missing index did not raise"
+rescue IndexError
+end
+puts "integer Range map and Array fetch OK"
+"#,
+        )
+        .assert_passes();
+}
+
+#[test]
+fn relation_to_sql_remains_an_executable_scoped_query() {
+    emit_and_run::real_blog()
+        .edit(
+            "app/models/article.rb",
+            "class Article < ApplicationRecord",
+            r#"class Article < ApplicationRecord
+  scope :selected, -> { where(title: "Selected") }
+
+  def self.scoped_sql
+    selected.to_sql
+  end
+
+  def self.direct_sql
+    where(title: "Selected").to_sql
+  end
+
+  def self.parked_sql
+    query = where(title: "Selected")
+    query.to_sql
+  end
+
+  def self.query_source
+    Article.where(title: "Selected")
+  end
+
+  def self.helper_sql
+    query_source.to_sql
+  end
+
+  def comments_sql
+    comments.to_sql
+  end
+"#,
+        )
+        .run_ruby(
+            r#"
+selected = Article.create!(title: "Selected", body: "a long enough body")
+other = Article.create!(title: "Other", body: "a long enough body")
+[Article.scoped_sql, Article.direct_sql, Article.parked_sql, Article.helper_sql].each do |sql|
+  raise sql.inspect unless sql.is_a?(String) && sql.include?("Selected")
+  rows = Article.connection.select_all(sql)
+  raise rows.inspect unless rows.to_a.map { |row| row["title"] } == ["Selected"]
+end
+Comment.create!(article_id: selected.id, commenter: "reader", body: "selected comment")
+Comment.create!(article_id: other.id, commenter: "reader", body: "other comment")
+rows = Comment.connection.select_all(selected.comments_sql)
+raise rows.inspect unless rows.to_a.map { |row| row["body"] } == ["selected comment"]
+puts "Relation to_sql query OK"
+"#,
+        )
+        .assert_passes();
+}
