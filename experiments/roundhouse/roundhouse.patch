+const SCHEMA: &str = r#"ActiveRecord::Schema.define do
+  create_table "calendar_entries" do |t|
+    t.date "due_on"
+  end
+end
+"#;
+
+const MODEL: &str = r#"class CalendarEntry < ApplicationRecord
+  def start_date
+    Date.new(2024, 1, 31)
+  end
+  def end_date
+    Date.new(2024, 3, 31)
+  end
+  def literal_window
+    CalendarEntry.where(due_on: start_date..end_date)
+  end
+  def open_window
+    CalendarEntry.where(due_on: start_date..)
+  end
+  def dynamic_window
+    interval = start_date...end_date
+    CalendarEntry.where(due_on: interval)
+  end
+  def conditional_window(flag)
+    relation = flag ? CalendarEntry.where(id: 1) : CalendarEntry.all
+    relation.where(due_on: start_date..end_date)
+  end
+  def beginless_window
+    interval = ..end_date
+    CalendarEntry.where(due_on: interval)
+  end
+  def range_value
+    start_date...end_date
+  end
+  def first_bound
+    range_value.begin
+  end
+  def last_bound
+    range_value.end
+  end
+  def parsed_date(value)
+    Date.iso8601(value)
+  end
+  def calendar
+    Date.current.beginning_of_month.end_of_week
+  end
+  def day_names
+    Date::DAYNAMES
+  end
+  def shifted
+    start_date.advance(months: 1)
+  end
+  def mapped_dates(count: 3)
+    count.times.map do |offset|
+      start_date.advance(weeks: offset)
+    end
+  end
+  def collected_indices(count = 3)
+    count.times.collect { |offset| offset }
+  end
+  def times_block_result
+    3.times { |offset| offset + 1 }
+  end
+  def duration_window
+    1.week.ago.to_date..Date.current
+  end
+  def duration_month_window
+    3.months.ago.to_date.beginning_of_month..Date.current
+  end
+  def date_delta
+    (end_date - start_date).to_i
+  end
+  def next_day
+    start_date + 1
+  end
+  def previous_day
+    start_date - 1
+  end
+  def ordered
+    start_date < end_date && start_date <= end_date && end_date > start_date && end_date >= start_date
+  end
+  def from_time
+    Time.utc(2024, 2, 29).to_date
+  end
+end
+"#;
+
+fn app(model: &str) -> App {
+    let tree = [("db/schema.rb", SCHEMA), ("app/models/calendar_entry.rb", model)]
+        .into_iter().map(|(p, s)| (p.into(), s.as_bytes().to_vec())).collect();
+    let mut app = ingest_app_from_tree(tree).unwrap();
+    let lower = roundhouse::session::analyze_and_lower(&mut app);
+    let errors = roundhouse::analyze::diagnose(&app).into_iter().chain(lower)
+        .filter(|d| d.severity == Severity::Error).collect::<Vec<_>>();
+    assert!(errors.is_empty(), "{errors:?}");
+    app
+}
+
+#[test]
+fn shared_date_helpers_keep_the_concrete_travel_clock_type() {
+    use roundhouse::expr::{Expr, ExprNode};
+    use roundhouse::ty::Ty;
+    fn inspect(expr: &Expr, clock_reads: &mut usize) {
+        assert!(!matches!(&expr.ty, None | Some(Ty::Var { .. } | Ty::Untyped)), "{expr:?}");
+        if matches!(&*expr.node, ExprNode::Send { method, .. } if method.as_str() == "now") {
+            assert_eq!(expr.ty.as_ref(), Some(&Ty::Time));
+            *clock_reads += 1;
+        }
+        expr.node.for_each_child(&mut |child| inspect(child, clock_reads));
+    }
+    let methods = roundhouse::runtime_src::parse_methods_with_rbs(
+        include_str!("../runtime/ruby/date_range.rb"),
+        include_str!("../runtime/ruby/date_range.rbs"),
+    ).unwrap();
+    let method = methods.iter().find(|method| method.name.as_str() == "current_date").unwrap();
+    assert_eq!(method.body.ty.as_ref(), Some(&Ty::Date));
+    let mut clock_reads = 0;
+    inspect(&method.body, &mut clock_reads);
+    assert_eq!(clock_reads, 1);
+}
+
+#[test]
+fn model_date_helpers_retain_their_owner_and_interval_types() {
+    use roundhouse::ident::{ClassId, Symbol};
+    use roundhouse::ty::Ty;
+    let app = app(MODEL);
+    let owner = &app.models[0].name;
+    let interval = Ty::Class { id: ClassId(Symbol::from("Range")), args: vec![Ty::Date] };
+    let lcs = roundhouse::lower::lower_models_to_library_classes(&app.models, &app.schema, vec![]);
+    let class = lcs.iter().find(|lc| &lc.name == owner).unwrap();
+    for (name, expected) in [("start_date", Ty::Date), ("end_date", Ty::Date),
+        ("range_value", interval), ("first_bound", Ty::Date), ("last_bound", Ty::Date)] {
+        let method = class.methods.iter().find(|method| method.name.as_str() == name).unwrap();
+        assert_eq!(method.enclosing_class.as_ref(), Some(&owner.0), "{name}");
+        assert_eq!(method.body.ty.as_ref(), Some(&expected), "{name}");
+        assert!(matches!(&method.signature, Some(Ty::Fn { ret, .. }) if **ret == expected), "{name}: {:?}", method.signature);
+    }
+}
