+++ b/tests/relation_bounded_batches.rs
@@ -0,0 +1,121 @@
+//! Execute the runtime against SQLite: filtering changes during a batch must
+//! not skip records, and each query must stay bounded by batch_size.
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+#[test]
+fn emitted_unscope_and_keyset_batches_keep_their_query_contract() {
+    let run = emit_and_run::real_blog()
+        .edit("app/controllers/articles_controller.rb",
+            "@articles = Article.includes(:comments).order(created_at: :desc)",
+            "@articles = Article.includes(:comments).order(created_at: :desc)\n    Article.all.find_in_batches(batch_size: 2) { |rows| rows.length }\n    Article.all.find_each(batch_size: 2) { |record| record.id }\n    head :ok")
+        .write("app/controllers/batch_probe_controller.rb", r#"
+class BatchProbeController < ApplicationController
+  def inline
+    batches = []
+    Article.where(title: "pending").find_in_batches(batch_size: 2) { |rows| batches << rows.map { |row| row.id } }
+    batches
+  end
+
+  def assigned
+    query = Article.where(title: "pending")
+    batches = []
+    query.find_in_batches(batch_size: 2) { |rows| batches << rows.map { |row| row.id } }
+    batches
+  end
+
+  def helper_return
+    batches = []
+    pending.find_in_batches(batch_size: 2) { |rows| batches << rows.map { |row| row.id } }
+    batches
+  end
+
+  def each_record
+    ids = []
+    pending.find_each(batch_size: 2) { |record| ids << record.id }
+    ids
+  end
+
+  def batch_result
+    pending.find_in_batches(batch_size: 2) { |rows| rows.length }
+  end
+
+  def each_result
+    pending.find_each(batch_size: 2) { |record| record.id }
+  end
+
+  def stripped_query
+    query = Article.where(title: "pending").order(id: :desc).limit(1)
+    query.unscope(:order, :limit).to_sql
+  end
+
+  def enumerable_selection
+    Article.all.select { |record| record.title == "pending" }.length
+  end
+
+  private
+
+  def pending
+    Article.where(title: "pending")
+  end
+end
+"#)
+        .run_ruby(r#"
+adapter = ActiveRecord.adapter
+[-4, 0, 3, 11, 20].each do |id|
+  adapter.execute_ddl("INSERT INTO articles (id, title, body, created_at, updated_at) VALUES (#{id}, 'pending', 'long enough body', '2024-01-01 00:00:00', '2024-01-01 00:00:00')")
+end
+require File.expand_path("app/controllers/articles_controller", Dir.pwd)
+ArticlesController.new.index
+require File.expand_path("app/controllers/batch_probe_controller", Dir.pwd)
+probe = BatchProbeController.new
+expected = [[-4, 0], [3, 11], [20]]
+raise "inline batch query lost" unless probe.inline == expected
+raise "assigned batch query lost" unless probe.assigned == expected
+raise "helper-return batch query lost" unless probe.helper_return == expected
+raise "find_each query lost" unless probe.each_record == [-4, 0, 3, 11, 20]
+raise "batch result changed" unless probe.batch_result.nil?
+raise "find_each result changed" unless probe.each_result.nil?
+raise "Enumerable selection changed" unless probe.enumerable_selection == 5
+raise "assigned unscope changed" if probe.stripped_query.include?("LIMIT") || probe.stripped_query.include?("DESC")
+scope = ActiveRecord::Relation.new(Article).where(title: "pending").select("id").order("id DESC").limit(3).offset(1)
+original_sql = scope.to_sql
+clean = scope.unscope(:select, :order, :limit, :offset)
+raise "mutated original" unless scope.to_sql == original_sql
+raise "clauses survived" if clean.to_sql.include?(" DESC") || clean.to_sql.include?("LIMIT") || clean.to_sql.include?("OFFSET")
+raise "projection survived" unless clean.to_sql.include?("SELECT articles.*")
+raise "count" unless clean.count == 5
+raise "where scope lost" unless clean.to_sql.include?("pending")
+raise "where unscope" unless clean.unscope(:where).where(title: "other").count == 0
+begin
+  scope.unscope(:bogus)
+  raise "unknown clause accepted"
+rescue ArgumentError
+end
+observed = []
+scope.find_in_batches(batch_size: 2) { |rows| observed << rows.map(&:id) }
+raise "limit/offset batches: #{observed.inspect}" unless observed == [[0, 3], [11]]
+individual = []
+result = scope.find_each(batch_size: 2) { |row| individual << row.id }
+raise "individual cursor" unless individual == [0, 3, 11] && result.nil?
+seen = []
+result = clean.order("id DESC").find_in_batches(batch_size: 2) do |rows|
+  raise "oversized batch" unless rows.length <= 2
+  seen << rows.map(&:id)
+  rows.each { |row| row.title = "done"; row.save! }
+end
+raise "return value" unless result.nil?
+raise "skipped after mutation: #{seen.inspect}" unless seen == [[-4, 0], [3, 11], [20]]
+raise "unprocessed rows" unless clean.count == 0
+[0, -1].each do |size|
+  begin
+    clean.find_in_batches(batch_size: size) { |_| raise "yielded invalid size" }
+    raise "invalid size accepted"
+  rescue ArgumentError
+  end
+end
+puts "bounded batches pass"
+"#);
+    run.assert_passes();
+    assert_eq!(run.stdout, "bounded batches pass\n");
+}
