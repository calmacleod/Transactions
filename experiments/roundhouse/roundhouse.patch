--- /dev/null
+++ b/tests/route_record_boundary_emit_and_run.rs
@@ -0,0 +1,164 @@
+//! A route segment retains its record identity through the Ruby-family
+//! RBS boundary, including serializer parameters the analyzer cannot name.
+
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+const ROUTES: &str = r##"
+Rails.application.routes.draw do
+  resources :articles do
+    resources :comments
+  end
+  get "/copies/:id(.:format)", to: "articles#show", as: :copy
+  get "/top(/:length(/page/:page))", to: "articles#index", as: :top
+  scope "/users/:user_id", as: :user, defaults: { user_id: "me" } do
+    resources :articles
+  end
+  root "articles#index"
+end
+"##;
+
+const APP_CONTROLLER: &str = r##"
+class ApplicationController < ActionController::Base
+  def record_path(value)
+    article_path(value)
+  end
+  def formatted_record_path(value)
+    copy_path(value, format: :json)
+  end
+  def scalar_named_like_a_model(article)
+    article_path(article)
+  end
+end
+"##;
+
+const HELPER: &str = r##"
+module UrlProbeHelper
+  def implicit(value)
+    article_path(value)
+  end
+end
+"##;
+
+#[test]
+fn default_record_and_scalar_ids_survive_untyped_controller_and_library_parameters() {
+    emit_and_run::real_blog()
+        .write("config/routes.rb", ROUTES)
+        .write("app/controllers/application_controller.rb", APP_CONTROLLER)
+        .write("app/helpers/url_probe_helper.rb", HELPER)
+        .edit("app/controllers/articles_controller.rb", "  def show\n  end", "  def show\n    @article = Article.find(params[:id])\n  end")
+        .write("app/views/articles/show.html.erb", "<%= link_to 'record', article_path(@article) %>")
+        .run_ruby(r##"
+require File.expand_path("app/controllers/application_controller", Dir.pwd)
+require File.expand_path("app/models/url_probe_helper", Dir.pwd)
+require File.expand_path("app/views/articles/show", Dir.pwd)
+article = Article.create!(title: "Selected", body: "a long enough body")
+expected = "/articles/#{article.id}"
+controller = ApplicationController.new
+raise controller.record_path(article).inspect unless controller.record_path(article) == expected
+raise UrlProbeHelper.implicit(article).inspect unless UrlProbeHelper.implicit(article) == expected
+raise unless controller.scalar_named_like_a_model(42) == "/articles/42"
+raise unless controller.scalar_named_like_a_model("text-id") == "/articles/text-id"
+raise unless RouteHelpers.article_path(article) == expected
+raise unless RouteHelpers.article_path(42) == "/articles/42"
+raise unless RouteHelpers.article_path("text-id") == "/articles/text-id"
+raise unless controller.formatted_record_path(article) == "/copies/#{article.id}.json"
+raise unless RouteHelpers.top_path == "/top"
+raise unless RouteHelpers.top_path(3) == "/top/3"
+raise unless RouteHelpers.top_path(3, 2) == "/top/3/page/2"
+raise unless RouteHelpers.user_article_path(article) == "/users/me/articles/#{article.id}"
+raise unless RouteHelpers.user_article_path(article, user_id: "other") == "/users/other/articles/#{article.id}"
+html = Views::Articles.show(article)
+raise html unless html.include?("href=\"#{expected}\"")
+puts "record and scalar route boundaries OK"
+"##)
+        .assert_passes();
+}
+
+#[test]
+fn custom_to_param_survives_controller_library_html_and_jbuilder_routes() {
+    emit_and_run::real_blog()
+        .write("config/routes.rb", ROUTES)
+        .write("app/controllers/application_controller.rb", APP_CONTROLLER)
+        .write("app/helpers/url_probe_helper.rb", HELPER)
+        .edit("app/models/article.rb", "class Article < ApplicationRecord", r##"class Article < ApplicationRecord
+  def to_param
+    "slug-" + title.to_s
+  end
+"##)
+        .edit("app/controllers/articles_controller.rb", "  def show\n  end", "  def show\n    @article = Article.find(params[:id])\n  end")
+        .write("app/views/articles/show.html.erb", "<%= link_to 'record', article_path(@article) %>")
+        .write("app/views/articles/show.json.jbuilder", "json.path article_url(@article)\n")
+        .run_ruby(r##"
+require File.expand_path("app/controllers/application_controller", Dir.pwd)
+require File.expand_path("app/models/url_probe_helper", Dir.pwd)
+require File.expand_path("app/views/articles/show", Dir.pwd)
+article = Article.create!(title: "selected", body: "a long enough body")
+controller = ApplicationController.new
+expected = "/articles/slug-selected"
+raise unless controller.record_path(article) == expected
+raise unless UrlProbeHelper.implicit(article) == expected
+raise unless RouteHelpers.article_path(article) == expected
+raise unless RouteHelpers.article_path(article.id) == "/articles/#{article.id}"
+raise unless controller.formatted_record_path(article) == "/copies/slug-selected.json"
+raise unless RouteHelpers.article_comment_path(article, 7) == "/articles/slug-selected/comments/7"
+raise unless RouteHelpers.user_article_path(article, user_id: article) == "/users/slug-selected/articles/slug-selected"
+html = Views::Articles.show(article)
+raise html unless html.include?("href=\"#{expected}\"")
+require File.expand_path("app/views/articles/show_json", Dir.pwd)
+json = Views::Articles.show_json(article)
+raise json unless json.include?(expected)
+puts "custom to_param route boundaries OK"
+"##)
+        .assert_passes();
+}
+
+#[test]
+fn ruby_segment_signatures_preserve_optional_and_keyword_kinds_without_widening_other_targets() {
+    use roundhouse::ingest::ingest_app_from_tree;
+    use roundhouse::lower::routes_to_library;
+    use roundhouse::ty::{ParamKind, Ty};
+    let app = ingest_app_from_tree(
+        vec![("config/routes.rb".into(), ROUTES.as_bytes().to_vec())]
+            .into_iter()
+            .collect(),
+    )
+    .unwrap();
+    let ruby = routes_to_library::ruby::lower_route_helpers(&app);
+    let params = |name: &str| match &ruby
+        .iter()
+        .find(|f| f.name.as_str() == name)
+        .unwrap()
+        .signature
+    {
+        Some(Ty::Fn { params, .. }) => params.clone(),
+        other => panic!("{other:?}"),
+    };
+    let is_object = |ty: &Ty| matches!(ty, Ty::Class { id, args } if id.0.as_str() == "Object" && args.is_empty());
+    let member = params("article_path");
+    assert!(is_object(&member[0].ty));
+    assert_eq!(member[0].kind, ParamKind::Required);
+    let optional = params("top_path");
+    assert!(optional
+        .iter()
+        .all(|p| is_object(&p.ty) && p.kind == ParamKind::Optional));
+    let scoped = params("user_article_path");
+    assert!(is_object(&scoped[0].ty));
+    assert!(is_object(&scoped[1].ty));
+    assert_eq!(scoped[1].kind, ParamKind::Keyword { required: false });
+    let format = params("copy_path");
+    assert!(is_object(&format[0].ty));
+    // Named formats are demand-driven variants, exercised by the
+    // formatted_record_path source call in the executable probes.
+    assert_eq!(format.len(), 1);
+    let strict = routes_to_library::lower_routes_to_library_functions(&app);
+    let Some(Ty::Fn { params, .. }) = &strict
+        .iter()
+        .find(|f| f.name.as_str() == "article_path")
+        .unwrap()
+        .signature
+    else {
+        panic!()
+    };
+    assert_eq!(params[0].ty, Ty::Int);
+}
diff --git a/tests/runtime_block_signatures.rs b/tests/runtime_block_signatures.rs
new file mode 100644
index 00000000..4dc15b2b
--- /dev/null
+++ b/tests/runtime_block_signatures.rs
@@ -0,0 +1,112 @@
+//! Real runtime RBS block contracts must survive return-only registry seeds.
+use std::collections::HashMap;
+use std::process::Command;
+
+use roundhouse::analyze::ClassInfo;
+use roundhouse::expr::Expr;
+use roundhouse::ident::{ClassId, Symbol};
+use roundhouse::runtime_src::parse_methods_with_rbs_in_ctx;
+use roundhouse::ty::Ty;
+
+fn assert_no_inference_gaps(expr: &Expr) {
+    assert!(
+        !matches!(expr.ty, None | Some(Ty::Var { .. })),
+        "inference gap: {expr:?}"
+    );
+    expr.node.for_each_child(&mut assert_no_inference_gaps);
+}
+
+#[test]
+fn single_array_block_signature_binds_elements_and_executes_emitted_ruby() {
+    let ruby = r#"
+class Batch
+  def rows
+    yield [1, 2]
+    nil
+  end
+
+  def consume
+    rows { |items| items.each { |item| item.to_s } }
+  end
+end
+"#;
+    let rbs = r#"
+class Batch
+  def rows: () { (Array[Integer]) -> void } -> nil
+  def consume: () -> nil
+end
+"#;
+    // This is the runtime sweep's cross-file registry representation.
+    // Own RBS must restore the block contract without changing this input.
+    let mut batch = ClassInfo::default();
+    batch.instance_methods.insert(Symbol::from("rows"), Ty::Nil);
+    let mut classes = HashMap::new();
+    classes.insert(ClassId(Symbol::from("Batch")), batch);
+    let methods = parse_methods_with_rbs_in_ctx(ruby, rbs, &classes).expect("runtime parses");
+    let consume = methods
+        .iter()
+        .find(|m| m.name.as_str() == "consume")
+        .unwrap();
+    assert_eq!(consume.body.ty, Some(Ty::Nil));
+    assert_no_inference_gaps(&consume.body);
+    assert_eq!(
+        classes[&ClassId(Symbol::from("Batch"))].instance_methods[&Symbol::from("rows")],
+        Ty::Nil
+    );
+    let defs: String = methods
+        .iter()
+        .map(roundhouse::emit::ruby::emit_method)
+        .collect();
+    let emitted = format!("class Batch\n{defs}\nend\nraise 'wrong return' unless Batch.new.consume.nil?\nputs 'block signature pass'\n");
+    let output = Command::new("ruby")
+        .arg("-e")
+        .arg(&emitted)
+        .output()
+        .expect("ruby");
+    assert!(
+        output.status.success(),
+        "emitted:\n{emitted}\n{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert_eq!(
+        String::from_utf8_lossy(&output.stdout),
+        "block signature pass\n"
+    );
+}
+
+#[test]
+fn zero_and_multiple_yield_parameters_keep_the_declared_block_arity() {
+    let ruby = r#"
+class Arity
+  def none
+    yield
+    nil
+  end
+
+  def pair
+    yield 3, "four"
+    nil
+  end
+
+  def consume
+    none { 1.to_s }
+    pair { |number, word| number.to_s + word }
+  end
+end
+"#;
+    let rbs = r#"
+class Arity
+  def none: () { () -> void } -> nil
+  def pair: () { (Integer, String) -> void } -> nil
+  def consume: () -> nil
+end
+"#;
+    let methods =
+        parse_methods_with_rbs_in_ctx(ruby, rbs, &HashMap::new()).expect("runtime parses");
+    let consume = methods
+        .iter()
+        .find(|m| m.name.as_str() == "consume")
+        .unwrap();
+    assert_eq!(consume.body.ty, Some(Ty::Nil));
+    assert_no_inference_gaps(&consume.body);
+}
diff --git a/tests/sanitize_sql_like.rs b/tests/sanitize_sql_like.rs
new file mode 100644
index 00000000..5acc5de4
--- /dev/null
+++ b/tests/sanitize_sql_like.rs
@@ -0,0 +1,48 @@
+//! Runtime proof for Rails LIKE wildcard escaping, on both the literal
+//! framework base and a model subclass. Keep it in the shared runtime.
+
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+#[test]
+fn emitted_like_escaping_matches_rails_default_and_custom_markers() {
+    emit_and_run::real_blog()
+        .write("app/services/like_probe.rb", r#"class LikeProbe
+  def self.default(value)
+    ActiveRecord::Base.sanitize_sql_like(value)
+  end
+
+  def self.custom(value, escape)
+    ActiveRecord::Base.sanitize_sql_like(value, escape)
+  end
+
+  def self.inherited(value)
+    Article.sanitize_sql_like(value)
+  end
+end
+"#)
+        .run_ruby(r#"
+cases = [
+  ["", "\\", ""],
+  ["plain text", "\\", "plain text"],
+  ["100%_done", "\\", "100\\%\\_done"],
+  ["back\\slash%_", "\\", "back\\\\slash\\%\\_"],
+  ["100%_!", "!", "100!%!_!!"],
+  ["100%_", "%", "100%%%_"],
+  ["100%_", "_", "100_%__"],
+  ["ab%_ab", "ab", "ababab%ab_abab"],
+  ["100%_", "", "100%_"],
+  ["café_50%", "!", "café!_50!%"]
+]
+cases.each do |value, escape, expected|
+  actual = LikeProbe.custom(value, escape)
+  raise "custom #{value.inspect}/#{escape.inspect}: #{actual.inspect}, expected #{expected.inspect}" unless actual == expected
+  if escape == "\\"
+    raise "default marker differs" unless LikeProbe.default(value) == expected
+    raise "model inheritance differs" unless LikeProbe.inherited(value) == expected
+  end
+end
+puts "sanitize_sql_like: default, inherited, custom, multicharacter, empty, Unicode passed"
+"#)
+        .assert_passes();
+}
