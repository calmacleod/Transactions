index a23e639f..577a0a75 100644
--- a/packages/bigdecimal/bigdecimal.rb
+++ b/packages/bigdecimal/bigdecimal.rb
@@ -259,7 +259,45 @@ class BigDecimal < Numeric
     @sign < 0 ? -n : n
   end
 
-  def to_s
+  def round(places = 0)
+    target = -places
+    digits = @digits.dup
+    if @exp < target
+      cut = target - @exp
+      up = cut <= digits.length && digits[cut - 1] >= 5
+      digits = cut >= digits.length ? [] : digits[cut, digits.length - cut]
+      if up
+        i = 0
+        carry = 1
+        while carry > 0
+          digits << 0 if i >= digits.length
+          value = digits[i] + carry
+          digits[i] = value % 10
+          carry = value / 10
+          i += 1
+        end
+      end
+      result = BigDecimal.new(@sign, digits, target)
+    else
+      result = self
+    end
+    places <= 0 ? result.to_i : result
+  end
+
+  def to_s(style = nil)
+    if style == 'F'
+      return '0.0' if @sign == 0
+      digits = __mantissa_s
+      point = digits.length + @exp
+      value = if point <= 0
+        '0.' + '0' * (-point) + digits
+      elsif point >= digits.length
+        digits + '0' * (point - digits.length) + '.0'
+      else
+        digits[0, point] + '.' + digits[point, digits.length - point]
+      end
+      return (@sign < 0 ? '-' : '') + value
+    end
     return "0.0" if @sign == 0
     m = __mantissa_s
     "#{@sign < 0 ? "-" : ""}0.#{m}e#{m.length + @exp}"
