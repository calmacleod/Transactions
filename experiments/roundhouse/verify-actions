def upload():
    marker = uuid.uuid4().hex[:8]
    date = fixture['month'] + '-01'
    csv = f'{date},Native upload {marker},12.345,,1234\n{date},Native refund {marker},,1.01,1234\n'
    boundary = 'native-' + marker
    body = f'--{boundary}\r\nContent-Disposition: form-data; name="csv_file"; filename="native-{marker}.csv"\r\nContent-Type: text/csv\r\n\r\n{csv}\r\n--{boundary}--\r\n'.encode()
    path = redirect(request('/imports', body, headers={'Content-Type': 'multipart/form-data; boundary=' + boundary}))
    assert '/preview' in path, path
    page = props(path)
    batch_id = page['import_batch']['id']
    assert sorted(r['amount_cents'] for r in page['rows']) == [101, 1235], page['rows']
    wait_for('SELECT classification_status, classification_reason FROM import_rows WHERE import_batch_id = ?', [batch_id], lambda rows: len(rows) == 2 and all(r['classification_status'] == 'classified' for r in rows))
    page = props(path)
    code, _, retained = request(page['actions']['download'])
    assert code == 200 and retained == csv, (code, retained)
    rows = [{**row, 'included': True} for row in page['rows']]
    redirect(request(page['actions']['commit'], {'import': {'rows': rows}}))
    page = props(path)
    assert page['import_batch']['complete'] is True and page['import_batch']['transactions_count'] == 2, {'batch':page['import_batch'],'flash':page.get('flash')}
    actual = database.execute('SELECT amount_cents FROM expense_transactions WHERE import_batch_id = ? ORDER BY amount_cents', [batch_id]).fetchall()
    assert [r[0] for r in actual] == [101, 1235], actual
check('CSV upload, background classification, retained download and commit', upload)

