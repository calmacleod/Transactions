    assert request('/session', credentials, headers={'X-CSRF-Token': None, 'X-XSRF-Token': 'invalid'})[0] == 422
    assert request('/session', credentials, headers={'Origin': 'http://attacker.test'})[0] == 422
    invalid_credentials = [
        {**credentials, 'password': 'incorrect'},
        {**credentials, 'email_address': 'missing-native@example.test'},
        {**credentials, 'password': ''},
        {**credentials, 'password': None},
        {'email_address': credentials['email_address']},
    ]
    for invalid in invalid_credentials:
