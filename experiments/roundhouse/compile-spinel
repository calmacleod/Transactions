#!/usr/bin/env python3
"""Compile a generated Spinel project using its resolved dependency flags."""
import argparse
import os
from pathlib import Path
import shlex
import subprocess
import time

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("project", type=Path)
parser.add_argument("--without-rbs", action="store_true")
parser.add_argument("--debug", action="store_true", help="include large debugger symbols")
args = parser.parse_args()
root = Path(__file__).resolve().parents[2]
work = root / "tmp/roundhouse"
project = args.project.resolve()
environment = os.environ.copy()
environment.update(
    PATH=str(work / "spinel-toolchain/bin") + os.pathsep + environment["PATH"],
    XDG_CACHE_HOME=str(work / "spin-cache"),
    XDG_CONFIG_HOME=str(work / "spin-config"),
    SPIN_OFFLINE="1",
    CC="clang",
    LIBRARY_PATH=str(work / "jemalloc-install/lib") + os.pathsep + "/opt/homebrew/opt/icu4c/lib" + os.pathsep + environment.get("LIBRARY_PATH", ""),
)
resolved = subprocess.run(
    [str(work / "spinel-toolchain/bin/spin"), "flags"],
    cwd=project, env=environment, capture_output=True, text=True, check=True,
)
flags = shlex.split(resolved.stdout)
if args.without_rbs:
    index = flags.index("--rbs")
    del flags[index:index + 2]
command = [str(root / 'experiments/roundhouse/guard'), '--max-rss-mb',
           environment.get('NATIVE_BUILD_MAX_RSS_MB', '1024'), '--seconds', '600', '--',
           str(work / "spinel-toolchain/bin/spinel"), *flags,
           "-O", "0", *(['--debug'] if args.debug else []), "--no-inline-hot", "--jobs=1", "--cc=clang -Wno-nullability-completeness", "bin/blog.rb", "-o", "build/bin/blog"]
(project / "build/bin").mkdir(parents=True, exist_ok=True)
log = work / "logs" / (project.name + "-build.log")
start = time.monotonic()
with log.open("w") as output:
    result = subprocess.run(command, cwd=project, env=environment,
                            stdout=output, stderr=subprocess.STDOUT)
log.with_suffix(".exit").write_text(str(result.returncode) + "\n")
print("\n".join(log.read_text().splitlines()[-30:]))
print(f"Exit {result.returncode}; {time.monotonic() - start:.1f}s; log: {log}")
raise SystemExit(result.returncode)
