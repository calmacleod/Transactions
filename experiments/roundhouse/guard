#!/usr/bin/env python3
"""Run an experiment with a resident-memory ceiling and optional deadline."""
import argparse
import os
import signal
import subprocess
import sys
import time

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--max-rss-mb', type=int, default=512)
parser.add_argument('--seconds', type=int, default=0)
parser.add_argument('command', nargs=argparse.REMAINDER)
args = parser.parse_args()
command = args.command[1:] if args.command[:1] == ['--'] else args.command
if not command or args.max_rss_mb <= 0 or args.seconds < 0:
    parser.error('supply a command, positive memory limit and nonnegative deadline')

process = subprocess.Popen(command, start_new_session=True)
started = time.monotonic()
peak = 0
reason = None
interrupted_at = None
interrupted_signal = None
owned_pids = {process.pid}

def members():
    sample = subprocess.run(['ps', '-axo', 'pid=,ppid=,pgid=,rss='], capture_output=True,
                            text=True, check=True, start_new_session=True)
    rows = [tuple(map(int, row.split())) for row in sample.stdout.splitlines()]
    owned = owned_pids.intersection(pid for pid, _, _, _ in rows) | {process.pid}
    while True:
        children = {pid for pid, parent, group, _ in rows if parent in owned or group == process.pid}
        if children <= owned:
            break
        owned |= children
    owned_pids.intersection_update(pid for pid, _, _, _ in rows)
    owned_pids.update(owned)
    return [(pid, memory) for pid, _, _, memory in rows if pid in owned]

def stop(signum=signal.SIGTERM):
    # Signal concrete owned PIDs. Group signals are restricted by some
    # macOS app sandboxes even when the child itself can be terminated.
    for pid, _ in reversed(members()):
        try:
            os.kill(pid, signum)
        except ProcessLookupError:
            pass

def interrupted(signum, _frame):
    global interrupted_signal
    interrupted_signal = signum

signal.signal(signal.SIGINT, interrupted)
signal.signal(signal.SIGTERM, interrupted)
try:
    while process.poll() is None:
        if interrupted_signal is not None and interrupted_at is None:
            interrupted_at = time.monotonic()
            stop(interrupted_signal)
        memory_kb = sum(memory for _, memory in members())
        peak = max(peak, memory_kb)
        elapsed = time.monotonic() - started
        if interrupted_at is not None and time.monotonic() - interrupted_at > 2:
            reason = 'interrupted command did not stop within 2 seconds'
        elif memory_kb > args.max_rss_mb * 1024:
            reason = f'memory ceiling exceeded ({memory_kb / 1024:.1f} MiB > {args.max_rss_mb} MiB)'
        elif args.seconds and elapsed > args.seconds:
            reason = f'deadline exceeded ({args.seconds} seconds)'
        if reason:
            stop(signal.SIGKILL)
            process.wait()
            break
        time.sleep(.2)
finally:
    # Also clean up descendants if the launcher exited before its child.
    stop(signal.SIGKILL)
    print(f'[guard] {reason or "exited"}; peak process-group RSS {peak / 1024:.1f} MiB; '
          f'{time.monotonic() - started:.1f}s', file=sys.stderr)
sys.exit(124 if reason else (process.returncode if process.returncode >= 0 else 128 - process.returncode))
