#!/usr/bin/env python3
"""Exercise the compiled app over HTTP using the isolated experiment account."""
import http.cookiejar
from datetime import date
from decimal import Decimal
import json
from pathlib import Path
import re
import sqlite3
import sys
import urllib.error
import urllib.request

base = sys.argv[1] if len(sys.argv) > 1 else 'http://127.0.0.1:3901'
if not base.startswith('http://127.0.0.1:'):
    raise SystemExit('This check only targets the local experiment server')

class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, fp, code, message, headers, new_url):
        return None

cookies = http.cookiejar.CookieJar()
client = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cookies), NoRedirect())

def request(path, payload=None, headers=None):
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(base + path, data=data, headers=headers or {})
    try:
        response = client.open(req, timeout=10)
    except urllib.error.HTTPError as error:
        response = error
    return response.code, response.headers, response.read().decode()

code, _, _ = request('/up')
assert code == 200, f'health: {code}'
code, _, body = request('/session/new')
assert code == 200, f'login page: {code}'
page_match = re.search(r'<script data-page="app" type="application/json">(.*?)</script>', body)
page = json.loads(page_match[1])
assert page['component'] == 'sessions/new'
assert page['props']['auth']['authenticated'] is False
asset = re.search(r'<script type="module" src="([^"]+)"', body)[1]
code, _, asset_body = request(asset)
assert code == 200 and len(asset_body) > 1000, f'frontend asset: {code}'
csrf = re.search(r'<meta name="csrf-token" content="([^"]*)"', body)[1]
code, headers, _ = request('/session', {'email_address': 'spinel@example.test', 'password': 'spinel-local-experiment'},
                          {'Content-Type': 'application/json', 'X-CSRF-Token': csrf})
assert code == 303 and headers['Location'] == '/', f'login: {code}, {headers.get("Location")}'
code, _, body = request(headers['Location'], headers={'X-Inertia': 'true'})
if code == 200:
    page = json.loads(body)
    assert page['component'] == 'dashboard/index'
    assert page['props']['auth']['authenticated'] is True
else:
    raise AssertionError(f'Login destination failed: {code}: {body[:180]}')
code, headers, body = request('/session/new', headers={'X-Inertia': 'true'})
assert code == 200 and headers['X-Inertia'] == 'true', f'Inertia: {code}'
page = json.loads(body)
assert page['props']['auth']['authenticated'] is True
assert page['props']['auth']['email'] == 'spinel@example.test'
assert page['props']['auth']['admin'] is True
print('Native HTTP checks passed: health, HTML login, frontend assets, JSON login, login destination, signed session, Inertia JSON')

# Every application navigation destination must render with a real session.
paths = {
    '/': 'dashboard/index',
    '/transactions': 'transactions/index',
    '/spending': 'spending/index',
    '/imports': 'imports/index',
    '/budgets': 'budgets/index',
    '/subcategories': 'subcategories/index',
    '/insights': 'insights/index',
    '/offline': 'offline/show',
    '/settings': 'settings/show',
    '/ai_preferences': 'ai_preferences/show',
    '/admin': 'admin/dashboard/index',
    '/admin/ai_controls': 'ai_controls/show',
    '/admin/models': 'models/index',
}
failures = []
pages = {}
for path, component in paths.items():
    code, _, body = request(path, headers={'X-Inertia': 'true'})
    if code == 200:
        try:
            page = json.loads(body)
            assert page['component'] == component, page.get('component')
            assert page['props']['auth']['authenticated'] is True
            pages[path] = page['props']
        except (ValueError, KeyError, AssertionError) as error:
            failures.append(f'{path}: invalid Inertia page: {error}')
    else:
        failures.append(f'{path}: HTTP {code}: {body[:180]}')
    print(f'{path}: HTTP {code}')
for path in ('/ai_chats', '/offline/snapshot.json', '/manifest.json', '/service-worker.js', '/admin/jobs'):
    code, _, body = request(path)
    print(f'{path}: HTTP {code}')
    if code != 200:
        failures.append(f'{path}: HTTP {code}: {body[:180]}')
code, headers, body = request('/admin/first_time_flow_preview')
if code not in (302, 303) or headers.get('Location') != '/':
    failures.append(f'onboarding preview: HTTP {code}')
if failures:
    raise SystemExit('Native page failures:\n' + '\n'.join(failures))

if len(sys.argv) > 2:
    project = Path(sys.argv[2]).resolve()
    fixture = json.loads((project / 'storage/native-fixtures.json').read_text())
    # Action checks commit another CSV. Compare against independent database
    # values so this verifier still checks totals after those writes.
    month_start = date.today().replace(day=1)
    next_month = (month_start.replace(year=month_start.year + 1, month=1)
                  if month_start.month == 12 else month_start.replace(month=month_start.month + 1))
    with sqlite3.connect((project / 'storage/development.sqlite3').as_uri() + '?mode=ro', uri=True) as database:
        rows = database.execute(
            'SELECT direction, amount_cents, category_id FROM expense_transactions '
            'WHERE user_id = ? AND occurred_on >= ? AND occurred_on < ?',
            [fixture['user_id'], month_start.isoformat(), next_month.isoformat()]).fetchall()
    expenses = [row for row in rows if row[0] == 'debit']
    spend = sum(row[1] for row in expenses)
    assert pages['/']['metrics']['total_spend_label'] == f'${Decimal(spend) / 100:,.2f}', pages['/']['metrics']
    assert pages['/']['metrics']['transaction_count'] == len(rows)
    assert pages['/']['metrics']['expense_count'] == len(expenses)
    category = next(row for row in pages['/budgets']['categories'] if row['id'] == fixture['category_id'])
    assert category['spent_cents'] == sum(row[1] for row in expenses if row[2] == fixture['category_id']), category
    assert pages['/budgets']['unclassified']['spent_cents'] == sum(row[1] for row in expenses if row[2] is None)
    code, _, body = request(f"/imports/{fixture['import_id']}/preview", headers={'X-Inertia': 'true'})
    assert code == 200, f'import preview: {code}, {body[:160]}'
    assert len(json.loads(body)['props']['rows']) == 3
    code, _, body = request(f"/ai_chats/{fixture['chat_id']}")
    assert code == 200, f'chat detail: {code}, {body[:160]}'
    assert json.loads(body)['transaction_ids'] == [fixture['transaction_ids'][0]]
print('All native page checks passed')
