# Secrets defined here are available for env/secret in config/deploy.yml.
# Keep this file as dotenv-compatible assignments only.
# Required local environment:
#   KAMAL_BITWARDEN_PROJECT_ID=<Bitwarden Secrets Manager project UUID>
#   BWS_ACCESS_TOKEN=<Bitwarden Secrets Manager access token>

SECRETS=$(if [ -n "${KAMAL_BITWARDEN_PROJECT_ID}" ]; then kamal secrets fetch --adapter bitwarden-sm ${KAMAL_BITWARDEN_PROJECT_ID}/all; else printf '{}'; fi)

RAILS_MASTER_KEY=$(if [ -n "${RAILS_MASTER_KEY}" ]; then printf "%s" "${RAILS_MASTER_KEY}"; else kamal secrets extract RAILS_MASTER_KEY ${SECRETS}; fi)
ADMIN_EMAIL=$(if [ -n "${ADMIN_EMAIL}" ]; then printf "%s" "${ADMIN_EMAIL}"; else kamal secrets extract ADMIN_EMAIL ${SECRETS}; fi)
ADMIN_PASSWORD=$(if [ -n "${ADMIN_PASSWORD}" ]; then printf "%s" "${ADMIN_PASSWORD}"; else kamal secrets extract ADMIN_PASSWORD ${SECRETS}; fi)
