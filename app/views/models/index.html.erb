<section class="page-bar">
  <div>
    <p class="page-eyebrow">RubyLLM registry</p>
    <h1 class="page-title">Models</h1>
    <p class="page-subtitle">Browse imported provider metadata, capabilities, context windows, and pricing.</p>
  </div>

  <%= button_to "Refresh models", models_path, method: :post, class: "btn-primary" %>
</section>

<section class="kpi-grid">
  <div class="kpi-card">
    <p class="kpi-label">Available models</p>
    <p class="kpi-value"><%= Model.count %></p>
  </div>
  <div class="kpi-card">
    <p class="kpi-label">Providers</p>
    <p class="kpi-value"><%= @providers.count %></p>
  </div>
  <div class="kpi-card">
    <p class="kpi-label">Structured output</p>
    <p class="kpi-value"><%= Model.where("capabilities LIKE ?", "%structured_output%").count %></p>
  </div>
  <div class="kpi-card">
    <p class="kpi-label">Vision</p>
    <p class="kpi-value"><%= Model.where("capabilities LIKE ?", "%vision%").count %></p>
  </div>
</section>

<section class="panel mb-4">
  <%= form_with url: models_path, method: :get, class: "filter-panel" do |form| %>
    <div class="grid gap-3 md:grid-cols-[1fr_220px_220px_auto]">
      <div>
        <%= form.label :query, "Search", class: "field-label" %>
        <%= form.search_field :query, value: params[:query], class: "input-control", placeholder: "Model, family, or ID" %>
      </div>
      <div>
        <%= form.label :provider, "Provider", class: "field-label" %>
        <%= form.select :provider, options_for_select(@providers.map { |provider| ["#{provider} (#{@provider_counts[provider]})", provider] }, params[:provider]), { include_blank: "All providers" }, class: "input-control" %>
      </div>
      <div>
        <%= form.label :capability, "Capability", class: "field-label" %>
        <%= form.select :capability, options_for_select([["Structured output", "structured_output"], ["Function calling", "function_calling"], ["Vision", "vision"], ["Reasoning", "reasoning"]], params[:capability]), { include_blank: "All capabilities" }, class: "input-control" %>
      </div>
      <div class="flex items-end gap-2">
        <%= form.submit "Filter", class: "btn-primary" %>
        <%= link_to "Clear", models_path, class: "btn-secondary" %>
      </div>
    </div>
  <% end %>
</section>

<div class="panel overflow-hidden">
  <div class="table-scroll" data-table-size="wide">
    <table class="dense-table">
      <thead>
        <tr>
          <th>Model</th>
          <th>Provider</th>
          <th>I/O</th>
          <th>Capabilities</th>
          <th class="text-right">Context</th>
          <th class="text-right">Input / Output</th>
        </tr>
      </thead>
      <tbody>
        <% @models.each do |model| %>
          <tr>
            <td>
              <p class="font-bold text-zinc-950"><%= model.name %></p>
              <p class="mt-1 font-mono text-xs text-zinc-500"><%= model.model_id %></p>
              <% if model.family.present? %>
                <p class="mt-1 text-xs text-zinc-500"><%= model.family %></p>
              <% end %>
            </td>
            <td class="whitespace-nowrap text-zinc-700"><%= model.provider %></td>
            <td class="text-xs text-zinc-600">
              <p>In: <%= model.input_modalities.presence&.join(", ") || "unknown" %></p>
              <p class="mt-1">Out: <%= model.output_modalities.presence&.join(", ") || "unknown" %></p>
            </td>
            <td class="max-w-xs">
              <div class="flex flex-wrap gap-1.5">
                <% model.capabilities.each do |capability| %>
                  <span class="badge"><%= capability.to_s.humanize %></span>
                <% end %>
              </div>
            </td>
            <td class="whitespace-nowrap text-right text-zinc-600"><%= number_with_delimiter(model.context_window) if model.context_window.present? %></td>
            <td class="whitespace-nowrap text-right text-zinc-600">
              <% input_price = model.input_price_per_million %>
              <% output_price = model.output_price_per_million %>
              <% if input_price.present? || output_price.present? %>
                <%= number_to_currency(input_price || 0, precision: 2) %> / <%= number_to_currency(output_price || 0, precision: 2) %>
              <% else %>
                <span class="text-zinc-400">Unknown</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% if @models.size == 250 %>
  <p class="mt-4 text-sm text-zinc-500">Showing the first 250 matching models. Narrow the filters to inspect a smaller set.</p>
<% end %>
