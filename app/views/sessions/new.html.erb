<section class="mx-auto flex min-h-[70vh] max-w-md items-center">
  <div class="w-full rounded-lg border border-slate-200 bg-white p-8 shadow-sm">
    <p class="text-sm font-medium uppercase tracking-wide text-slate-500">Admin access</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-950">Sign in</h1>
    <p class="mt-3 text-sm leading-6 text-slate-600">Use the admin credential seeded from your environment.</p>

    <%= form_with url: session_url, class: "mt-8 space-y-5" do |form| %>
      <div>
        <%= form.label :email_address, "Email", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100" %>
      </div>

      <div>
        <%= form.label :password, "Password", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100" %>
      </div>

      <%= form.submit "Sign in", class: "w-full rounded-md bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800" %>
    <% end %>
  </div>
</section>
