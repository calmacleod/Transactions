<% total_spend = @dashboard.total_spend_cents %>
<% category_totals = @dashboard.category_totals %>
<% day_totals = @dashboard.day_of_week_totals %>
<% month_trend = @dashboard.month_trend %>
<% month_delta = @dashboard.month_to_month_delta %>
<% top_merchants = @dashboard.top_merchants %>
<% recommendations = @dashboard.recommendations %>
<% max_category = category_totals.map { |item| item[:cents] }.max.to_i %>
<% max_day_count = day_totals.map { |item| item[:count] }.max.to_i %>
<% max_month = month_trend.map { |item| item[:cents] }.max.to_i %>

<section class="page-bar">
  <div>
    <p class="page-eyebrow">Expense control</p>
    <h1 class="page-title">Spending dashboard</h1>
    <p class="page-subtitle">Current month activity, recent movement, and drill-downs into the transactions behind every number.</p>
  </div>

  <div class="action-row">
    <%= button_to "Classify pending", classifications_path, method: :post, class: "btn-primary" %>
    <%= button_to "Generate insights", insights_path, method: :post, class: "btn-secondary" %>
  </div>
</section>

<% if @classification_run.present? %>
  <%= render "classification_runs/classification_run", classification_run: @classification_run %>
<% end %>

<section class="kpi-grid">
  <%= link_to transactions_path(start_date: @month_range.begin, end_date: @month_range.end, direction: "debit"), class: "kpi-card" do %>
    <p class="kpi-label">Month spend</p>
    <p class="kpi-value"><%= money_from_cents(total_spend) %></p>
    <p class="kpi-note"><%= @month_range.begin.strftime("%b %-d") %> to <%= @month_range.end.strftime("%b %-d") %></p>
  <% end %>
  <%= link_to transactions_path(start_date: @month_range.begin, end_date: @month_range.end, direction: "debit"), class: "kpi-card" do %>
    <p class="kpi-label">Purchases</p>
    <p class="kpi-value"><%= @dashboard.expense_count %></p>
    <p class="kpi-note"><%= @dashboard.transaction_count %> total records</p>
  <% end %>
  <%= link_to transactions_path(start_date: @month_range.begin, end_date: @month_range.end, direction: "debit"), class: "kpi-card" do %>
    <p class="kpi-label">Average purchase</p>
    <p class="kpi-value"><%= money_from_cents(@dashboard.average_expense_cents) %></p>
    <p class="kpi-note">Debits only</p>
  <% end %>
  <%= link_to transactions_path(classified: "unclassified"), class: "kpi-card" do %>
    <p class="kpi-label">Unclassified</p>
    <p class="kpi-value"><%= ExpenseTransaction.unclassified.count %></p>
    <p class="kpi-note"><%= @categories.count %> categories configured</p>
  <% end %>
</section>

<section class="dashboard-grid">
  <div class="panel">
    <div class="panel-header">
      <h2 class="panel-title">Category allocation</h2>
      <%= link_to "All transactions", transactions_path, class: "text-xs font-bold text-zinc-500 hover:text-zinc-950" %>
    </div>
    <div>
      <% category_totals.first(8).each do |item| %>
        <% width = max_category.positive? ? ((item[:cents].to_f / max_category) * 100).round : 0 %>
        <%= link_to transactions_path(item[:filters]), class: "linked-row category-row" do %>
          <div class="min-w-0">
            <p class="truncate text-sm font-bold text-zinc-950"><%= item[:name] %></p>
            <p class="text-xs text-zinc-500"><%= pluralize(item[:count], "transaction") %></p>
          </div>
          <div class="flex items-center gap-3">
            <div class="metric-bar">
              <div class="metric-bar-fill" style="width: <%= width %>%"></div>
            </div>
            <span class="w-10 text-right text-xs font-semibold text-zinc-500"><%= item[:percent] %>%</span>
          </div>
          <div class="text-left md:text-right">
            <p class="text-sm font-bold text-zinc-950"><%= money_from_cents(item[:cents]) %></p>
            <% if item[:budget_cents].present? %>
              <p class="text-xs text-zinc-500"><%= item[:budget_percent] %>% budget</p>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="panel">
    <div class="panel-header">
      <h2 class="panel-title">Cutback targets</h2>
    </div>
    <div>
      <% recommendations.each do |recommendation| %>
        <%= link_to transactions_path(recommendation[:filters]), class: "block border-b border-zinc-200 px-4 py-3 hover:bg-zinc-50" do %>
          <div class="flex items-start justify-between gap-3">
            <h3 class="text-sm font-bold text-zinc-950"><%= recommendation[:title] %></h3>
            <span class="badge"><%= recommendation[:severity] %></span>
          </div>
          <p class="mt-1 text-xs leading-5 text-zinc-600"><%= recommendation[:body] %></p>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<section class="chart-grid">
  <div class="panel p-4">
    <div class="flex items-center justify-between">
      <h2 class="panel-title">Day-of-week frequency</h2>
      <span class="text-xs font-semibold text-zinc-500">click a day</span>
    </div>
    <div class="mt-4 flex h-48 items-end gap-2">
      <% day_totals.each do |day| %>
        <% height = max_day_count.positive? ? [((day[:count].to_f / max_day_count) * 100).round, 6].max : 6 %>
        <%= link_to transactions_path(day[:filters]), class: "flex min-w-0 flex-1 flex-col items-center gap-2 hover:opacity-80" do %>
          <div class="flex h-36 w-full items-end overflow-hidden rounded-lg bg-zinc-100">
            <div class="w-full rounded-lg bg-gradient-to-t from-zinc-950 to-cyan-600" style="height: <%= height %>%"></div>
          </div>
          <div class="text-center">
            <p class="text-xs font-bold text-zinc-800"><%= day[:name] %></p>
            <p class="text-xs text-zinc-500"><%= day[:count] %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="panel p-4">
    <div class="flex items-center justify-between">
      <h2 class="panel-title">Recent month movement</h2>
      <span class="badge <%= month_delta[:cents].positive? ? "text-red-500" : "text-emerald-700" %>">
        <%= month_delta[:cents].positive? ? "+" : "" %><%= money_from_cents(month_delta[:cents]) %>
      </span>
    </div>
    <div class="mt-4 flex h-48 items-end gap-3">
      <% month_trend.each do |month| %>
        <% height = max_month.positive? ? [((month[:cents].to_f / max_month) * 100).round, 6].max : 6 %>
        <%= link_to transactions_path(month[:filters]), class: "flex min-w-0 flex-1 flex-col items-center gap-2 hover:opacity-80" do %>
          <div class="flex h-36 w-full items-end overflow-hidden rounded-lg bg-zinc-100">
            <div class="w-full rounded-lg bg-gradient-to-t from-zinc-950 to-cyan-600" style="height: <%= height %>%"></div>
          </div>
          <div class="text-center">
            <p class="text-xs font-bold text-zinc-800"><%= month[:label] %></p>
            <p class="text-xs text-zinc-500"><%= money_from_cents(month[:cents]) %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<section class="lower-grid">
  <div class="panel">
    <div class="panel-header">
      <h2 class="panel-title">Top merchants</h2>
    </div>
    <% top_merchants.each do |merchant| %>
      <%= link_to transactions_path(merchant[:filters]), class: "flex items-center justify-between gap-4 border-b border-zinc-200 px-4 py-3 hover:bg-zinc-50" do %>
        <div class="min-w-0">
          <p class="truncate text-sm font-bold text-zinc-950"><%= merchant[:merchant].titleize %></p>
          <p class="text-xs text-zinc-500"><%= pluralize(merchant[:count], "purchase") %></p>
        </div>
        <p class="text-sm font-bold text-zinc-950"><%= money_from_cents(merchant[:cents]) %></p>
      <% end %>
    <% end %>
  </div>

  <div class="panel overflow-hidden">
    <div class="panel-header">
      <h2 class="panel-title">Latest transactions</h2>
      <%= link_to "View all", transactions_path, class: "text-xs font-bold text-zinc-500 hover:text-zinc-950" %>
    </div>
    <div class="table-scroll" data-table-size="compact">
      <table class="dense-table">
        <tbody>
          <% @transactions.each do |transaction| %>
            <tr>
              <td class="whitespace-nowrap text-zinc-500"><%= transaction.occurred_on.strftime("%b %-d") %></td>
              <td class="font-semibold text-zinc-950"><%= transaction.description %></td>
              <td><%= category_badge(transaction.category) %></td>
              <td class="whitespace-nowrap text-right font-bold <%= transaction_amount_class(transaction) %>"><%= transaction_money(transaction) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="grid gap-4 xl:grid-cols-[minmax(18rem,0.35fr)_minmax(0,0.65fr)]">
  <div class="panel p-4">
    <h2 class="panel-title">Import CSV</h2>
    <%= form_with url: imports_path, multipart: true, class: "mt-3 space-y-3" do |form| %>
      <%= form.file_field :csv_file, accept: ".csv,text/csv", class: "input-control block text-xs file:mr-3 file:border-0 file:bg-zinc-100 file:px-3 file:py-2 file:text-xs file:font-bold file:text-zinc-800 hover:file:bg-zinc-200" %>
      <%= form.submit "Import transactions", class: "btn-primary w-full" %>
    <% end %>
  </div>

  <div class="grid gap-3 md:grid-cols-2">
    <% @insights.each do |insight| %>
      <article class="panel p-4">
        <p class="text-[11px] font-bold uppercase tracking-wide text-cyan-700"><%= insight.severity %> · <%= insight.starts_on&.strftime("%b %Y") %></p>
        <h3 class="mt-1 text-sm font-bold text-zinc-950"><%= insight.title %></h3>
        <p class="mt-1 text-xs leading-5 text-zinc-600"><%= insight.body %></p>
      </article>
    <% end %>
  </div>
</section>
