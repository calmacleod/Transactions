<section class="mb-5 flex items-end justify-between border-b border-zinc-300 pb-4">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-zinc-950">Insights</h1>
    <p class="mt-1 text-sm text-zinc-600">Recent month-to-month observations generated from imported transactions.</p>
  </div>
  <%= button_to "Regenerate", insights_path, method: :post, class: "border border-zinc-950 bg-zinc-950 px-3 py-2 text-xs font-semibold text-white hover:bg-zinc-800" %>
</section>

<div class="grid gap-3 md:grid-cols-2">
  <% @insights.each do |insight| %>
    <article class="border border-zinc-300 bg-zinc-50 p-4">
      <div class="flex items-center justify-between gap-4">
        <h2 class="text-sm font-semibold text-zinc-950"><%= insight.title %></h2>
        <span class="border border-zinc-300 px-2 py-0.5 text-[11px] font-semibold uppercase text-zinc-600"><%= insight.severity %></span>
      </div>
      <p class="mt-2 text-sm leading-6 text-zinc-600"><%= insight.body %></p>
      <p class="mt-3 text-xs text-zinc-500"><%= insight.starts_on %> to <%= insight.ends_on %></p>
    </article>
  <% end %>
</div>
