<section class="page-bar">
  <div>
    <p class="page-eyebrow">Recent analysis</p>
    <h1 class="page-title">Insights</h1>
    <p class="page-subtitle">Month-to-month observations generated from imported transactions.</p>
  </div>
  <%= button_to "Regenerate", insights_path, method: :post, class: "btn-primary" %>
</section>

<div class="grid gap-3 md:grid-cols-2">
  <% @insights.each do |insight| %>
    <article class="panel p-4">
      <div class="flex items-start justify-between gap-4">
        <h2 class="text-base font-bold text-zinc-950"><%= insight.title %></h2>
        <span class="badge"><%= insight.severity %></span>
      </div>
      <p class="mt-2 text-sm leading-6 text-zinc-600"><%= insight.body %></p>
      <p class="mt-3 text-xs font-semibold text-zinc-400"><%= insight.starts_on %> to <%= insight.ends_on %></p>
    </article>
  <% end %>
</div>
