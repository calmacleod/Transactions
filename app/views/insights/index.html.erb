<section class="mb-6 flex items-end justify-between">
  <div>
    <h1 class="text-3xl font-semibold tracking-tight">Insights</h1>
    <p class="mt-2 text-sm text-slate-600">Generated observations from the imported transaction set.</p>
  </div>
  <%= button_to "Regenerate", insights_path, method: :post, class: "rounded-md bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800" %>
</section>

<div class="grid gap-4 md:grid-cols-2">
  <% @insights.each do |insight| %>
    <article class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between gap-4">
        <h2 class="text-lg font-semibold"><%= insight.title %></h2>
        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600"><%= insight.severity %></span>
      </div>
      <p class="mt-3 text-sm leading-6 text-slate-600"><%= insight.body %></p>
      <p class="mt-4 text-xs text-slate-400"><%= insight.starts_on %> to <%= insight.ends_on %></p>
    </article>
  <% end %>
</div>
