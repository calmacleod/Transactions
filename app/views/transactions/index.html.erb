<section class="mb-5 flex flex-col gap-3 border-b border-zinc-300 pb-4 lg:flex-row lg:items-end lg:justify-between">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-zinc-950">Transactions</h1>
    <p class="mt-1 text-sm text-zinc-600">Filter, inspect, and reclassify imported records.</p>
  </div>
  <div class="text-sm text-zinc-600">
    <span class="font-semibold text-zinc-950"><%= @transactions.size %></span> matching records
  </div>
</section>

<section class="mb-5 border border-zinc-300 bg-zinc-50">
  <div class="border-b border-zinc-300 px-4 py-3">
    <div class="flex flex-wrap items-center gap-2">
      <% TransactionFilter::QUICK_RANGES.each do |value, label| %>
        <% active = @filter_params["quick_range"] == value %>
        <%= link_to label, transactions_path(@filter_params.merge("quick_range" => value).except("start_date", "end_date")), class: "border px-2.5 py-1 text-xs font-semibold #{active ? "border-zinc-950 bg-zinc-950 text-white" : "border-zinc-300 bg-white text-zinc-700 hover:bg-zinc-100"}" %>
      <% end %>
      <%= link_to "Clear", transactions_path, class: "ml-auto border border-zinc-300 bg-white px-2.5 py-1 text-xs font-semibold text-zinc-700 hover:bg-zinc-100" %>
    </div>
  </div>

  <%= form_with url: transactions_path, method: :get, class: "grid gap-3 p-4 md:grid-cols-3 xl:grid-cols-6" do |form| %>
    <div>
      <%= form.label :query, "Search", class: "mb-1 block text-[11px] font-semibold uppercase tracking-wide text-zinc-500" %>
      <%= form.search_field :query, value: @filter_params["query"], class: "w-full border-zinc-300 text-sm", placeholder: "Merchant or memo" %>
    </div>
    <div>
      <%= form.label :start_date, "From", class: "mb-1 block text-[11px] font-semibold uppercase tracking-wide text-zinc-500" %>
      <%= form.date_field :start_date, value: @filter_params["start_date"] || @start_date, class: "w-full border-zinc-300 text-sm" %>
    </div>
    <div>
      <%= form.label :end_date, "To", class: "mb-1 block text-[11px] font-semibold uppercase tracking-wide text-zinc-500" %>
      <%= form.date_field :end_date, value: @filter_params["end_date"] || @end_date, class: "w-full border-zinc-300 text-sm" %>
    </div>
    <div>
      <%= form.label :category_id, "Category", class: "mb-1 block text-[11px] font-semibold uppercase tracking-wide text-zinc-500" %>
      <%= form.select :category_id, options_from_collection_for_select(@categories, :id, :name, @filter_params["category_id"]), { include_blank: "All categories" }, class: "w-full border-zinc-300 text-sm" %>
    </div>
    <div>
      <%= form.label :direction, "Type", class: "mb-1 block text-[11px] font-semibold uppercase tracking-wide text-zinc-500" %>
      <%= form.select :direction, options_for_select([["All", ""], ["Debits", "debit"], ["Credits", "credit"]], @filter_params["direction"]), {}, class: "w-full border-zinc-300 text-sm" %>
    </div>
    <div>
      <%= form.label :classified, "Status", class: "mb-1 block text-[11px] font-semibold uppercase tracking-wide text-zinc-500" %>
      <%= form.select :classified, options_for_select([["Any", ""], ["Classified", "classified"], ["Unclassified", "unclassified"]], @filter_params["classified"]), {}, class: "w-full border-zinc-300 text-sm" %>
    </div>
    <div>
      <%= form.label :day_of_week, "Day", class: "mb-1 block text-[11px] font-semibold uppercase tracking-wide text-zinc-500" %>
      <%= form.select :day_of_week, options_for_select(Date::DAYNAMES.each_with_index.map { |name, index| [name, index] }, @filter_params["day_of_week"]), { include_blank: "Any day" }, class: "w-full border-zinc-300 text-sm" %>
    </div>
    <div>
      <%= form.label :min_amount, "Min", class: "mb-1 block text-[11px] font-semibold uppercase tracking-wide text-zinc-500" %>
      <%= form.number_field :min_amount, value: @filter_params["min_amount"], step: "0.01", class: "w-full border-zinc-300 text-sm", placeholder: "0.00" %>
    </div>
    <div>
      <%= form.label :max_amount, "Max", class: "mb-1 block text-[11px] font-semibold uppercase tracking-wide text-zinc-500" %>
      <%= form.number_field :max_amount, value: @filter_params["max_amount"], step: "0.01", class: "w-full border-zinc-300 text-sm", placeholder: "500.00" %>
    </div>
    <div class="md:col-span-3 xl:col-span-3">
      <%= form.label :saved_query_id, "Saved", class: "mb-1 block text-[11px] font-semibold uppercase tracking-wide text-zinc-500" %>
      <%= form.select :saved_query_id, options_from_collection_for_select(@saved_queries, :id, :name, @selected_saved_query&.id), { include_blank: "No saved filter" }, class: "w-full border-zinc-300 text-sm" %>
    </div>
    <div class="flex items-end gap-2 md:col-span-3 xl:col-span-6">
      <%= form.submit "Apply filters", class: "border border-zinc-950 bg-zinc-950 px-3 py-2 text-xs font-semibold text-white hover:bg-zinc-800" %>
      <%= link_to "Reset", transactions_path, class: "border border-zinc-300 bg-white px-3 py-2 text-xs font-semibold text-zinc-700 hover:bg-zinc-100" %>
    </div>
  <% end %>
</section>

<section class="mb-5 grid gap-3 lg:grid-cols-[minmax(0,1fr)_360px]">
  <% if @filter.active? %>
    <div class="border border-zinc-300 bg-zinc-50 px-4 py-3 text-sm text-zinc-600">
      Showing
      <% if @start_date.present? && @end_date.present? %>
        <span class="font-semibold text-zinc-950"><%= @start_date.strftime("%b %-d, %Y") %> to <%= @end_date.strftime("%b %-d, %Y") %></span>
      <% elsif @start_date.present? %>
        records from <span class="font-semibold text-zinc-950"><%= @start_date.strftime("%b %-d, %Y") %></span>
      <% elsif @end_date.present? %>
        records through <span class="font-semibold text-zinc-950"><%= @end_date.strftime("%b %-d, %Y") %></span>
      <% else %>
        filtered records
      <% end %>
    </div>
  <% end %>

  <div class="border border-zinc-300 bg-zinc-50 px-4 py-3">
    <%= form_with url: saved_transaction_queries_path, class: "flex gap-2" do |form| %>
      <% @filter_params.each do |key, value| %>
        <%= hidden_field_tag "filters[#{key}]", value %>
      <% end %>
      <%= form.text_field :name, placeholder: "Save this filter as...", class: "min-w-0 flex-1 border-zinc-300 text-sm" %>
      <%= form.submit "Save", class: "border border-zinc-950 bg-zinc-950 px-3 py-2 text-xs font-semibold text-white" %>
    <% end %>
  </div>
</section>

<% if @saved_queries.any? %>
  <section class="mb-5 flex flex-wrap gap-2">
    <% @saved_queries.each do |query| %>
      <span class="inline-flex items-center border border-zinc-300 bg-zinc-50 text-xs font-semibold text-zinc-700">
        <%= link_to query.name, transactions_path(saved_query_id: query.id), class: "px-2.5 py-1 hover:bg-white" %>
        <%= button_to "x", saved_transaction_query_path(query), method: :delete, class: "border-l border-zinc-300 px-2 py-1 text-zinc-500 hover:bg-white hover:text-zinc-950" %>
      </span>
    <% end %>
  </section>
<% end %>

<div class="overflow-hidden border border-zinc-300 bg-zinc-50">
  <table class="min-w-full divide-y divide-zinc-200 text-sm">
    <thead class="bg-zinc-100 text-left text-[11px] font-semibold uppercase tracking-wide text-zinc-500">
      <tr>
        <th class="px-4 py-2">Date</th>
        <th class="px-4 py-2">Description</th>
        <th class="px-4 py-2">Category</th>
        <th class="px-4 py-2">Confidence</th>
        <th class="px-4 py-2 text-right">Amount</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-zinc-200">
      <% @transactions.each do |transaction| %>
        <tr class="align-top hover:bg-white">
          <td class="whitespace-nowrap px-4 py-3 text-zinc-500"><%= transaction.occurred_on.strftime("%b %-d, %Y") %></td>
          <td class="px-4 py-3">
            <p class="font-medium text-zinc-950"><%= transaction.description %></p>
            <% if transaction.classification_reason.present? %>
              <p class="mt-1 max-w-xl text-xs leading-5 text-zinc-500"><%= transaction.classification_reason %></p>
            <% end %>
          </td>
          <td class="px-4 py-3">
            <%= form_with model: transaction, url: transaction_path(transaction), method: :patch do |form| %>
              <%= form.select :category_id, options_from_collection_for_select(@categories, :id, :name, transaction.category_id), { include_blank: "Unclassified" }, class: "w-44 border-zinc-300 text-sm", onchange: "this.form.requestSubmit()" %>
            <% end %>
          </td>
          <td class="whitespace-nowrap px-4 py-3 text-zinc-500"><%= confidence_label(transaction) %></td>
          <td class="whitespace-nowrap px-4 py-3 text-right font-semibold <%= transaction_amount_class(transaction) %>"><%= transaction_money(transaction) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
