<section class="page-bar transactions-page-bar">
  <div>
    <p class="page-eyebrow">Transaction ledger</p>
    <h1 class="page-title">Transactions</h1>
    <p class="page-subtitle">Filter, inspect, save common views, and reclassify imported records.</p>
  </div>
  <div class="rounded-full border border-zinc-200 bg-stone-50 px-3 py-1.5 text-sm text-zinc-600">
    <span class="font-bold text-zinc-950"><%= @pagy.count %></span> matching records
  </div>
</section>

<section class="panel mb-4 overflow-hidden">
  <div class="flex flex-wrap items-center gap-2 border-b border-zinc-200 px-4 py-3">
    <% TransactionFilter::QUICK_RANGES.each do |value, label| %>
      <% active = @filter_params["quick_range"] == value %>
      <%= link_to label, transactions_path(@filter_params.merge("quick_range" => value).except("start_date", "end_date")), class: "quick-filter #{active ? "active" : ""}" %>
    <% end %>
    <%= link_to "Clear", transactions_path, class: "quick-filter ml-auto" %>
  </div>

  <%= form_with url: transactions_path, method: :get, class: "filter-panel" do |form| %>
    <div class="filter-grid">
      <div>
        <%= form.label :query, "Search", class: "field-label" %>
        <%= form.search_field :query, value: @filter_params["query"], class: "input-control", placeholder: "Merchant or memo" %>
      </div>
      <div>
        <%= form.label :start_date, "From", class: "field-label" %>
        <%= form.date_field :start_date, value: @filter_params["start_date"] || @start_date, class: "input-control" %>
      </div>
      <div>
        <%= form.label :end_date, "To", class: "field-label" %>
        <%= form.date_field :end_date, value: @filter_params["end_date"] || @end_date, class: "input-control" %>
      </div>
      <div>
        <%= form.label :category_id, "Category", class: "field-label" %>
        <%= form.select :category_id, options_from_collection_for_select(@categories, :id, :name, @filter_params["category_id"]), { include_blank: "All categories" }, class: "input-control" %>
      </div>
      <div>
        <%= form.label :direction, "Type", class: "field-label" %>
        <%= form.select :direction, options_for_select([["All", ""], ["Debits", "debit"], ["Credits", "credit"]], @filter_params["direction"]), {}, class: "input-control" %>
      </div>
      <div>
        <%= form.label :classified, "Status", class: "field-label" %>
        <%= form.select :classified, options_for_select([["Any", ""], ["Classified", "classified"], ["Unclassified", "unclassified"]], @filter_params["classified"]), {}, class: "input-control" %>
      </div>
      <div>
        <%= form.label :day_of_week, "Day", class: "field-label" %>
        <%= form.select :day_of_week, options_for_select(Date::DAYNAMES.each_with_index.map { |name, index| [name, index] }, @filter_params["day_of_week"]), { include_blank: "Any day" }, class: "input-control" %>
      </div>
      <div>
        <%= form.label :min_amount, "Min", class: "field-label" %>
        <%= form.number_field :min_amount, value: @filter_params["min_amount"], step: "0.01", class: "input-control", placeholder: "0.00" %>
      </div>
      <div>
        <%= form.label :max_amount, "Max", class: "field-label" %>
        <%= form.number_field :max_amount, value: @filter_params["max_amount"], step: "0.01", class: "input-control", placeholder: "500.00" %>
      </div>
      <div class="xl:col-span-3">
        <%= form.label :saved_query_id, "Saved", class: "field-label" %>
        <%= form.select :saved_query_id, options_from_collection_for_select(@saved_queries, :id, :name, @selected_saved_query&.id), { include_blank: "No saved filter" }, class: "input-control" %>
      </div>
    </div>

    <div class="mt-3 flex items-center gap-2">
      <%= form.submit "Apply filters", class: "btn-primary" %>
      <%= link_to "Reset", transactions_path, class: "btn-secondary" %>
    </div>
  <% end %>
</section>

<section class="mb-4 grid gap-3 lg:grid-cols-[minmax(0,1fr)_360px]">
  <% if @filter.active? %>
    <div class="panel px-4 py-3 text-sm text-zinc-600">
      Showing
      <% if @start_date.present? && @end_date.present? %>
        <span class="font-bold text-zinc-950"><%= @start_date.strftime("%b %-d, %Y") %> to <%= @end_date.strftime("%b %-d, %Y") %></span>
      <% elsif @start_date.present? %>
        records from <span class="font-bold text-zinc-950"><%= @start_date.strftime("%b %-d, %Y") %></span>
      <% elsif @end_date.present? %>
        records through <span class="font-bold text-zinc-950"><%= @end_date.strftime("%b %-d, %Y") %></span>
      <% else %>
        filtered records
      <% end %>
    </div>
  <% end %>

  <div class="panel px-4 py-3">
    <%= form_with url: saved_transaction_queries_path, class: "flex gap-2" do |form| %>
      <% @filter_params.each do |key, value| %>
        <%= hidden_field_tag "filters[#{key}]", value %>
      <% end %>
      <%= form.text_field :name, placeholder: "Save this filter as...", class: "input-control min-w-0 flex-1" %>
      <%= form.submit "Save", class: "btn-primary" %>
    <% end %>
  </div>
</section>

<% if @saved_queries.any? %>
  <section class="mb-4 flex flex-wrap gap-2">
    <% @saved_queries.each do |query| %>
      <span class="inline-flex items-center rounded-full border border-zinc-200 bg-stone-50 text-xs font-bold text-zinc-700">
        <%= link_to query.name, transactions_path(saved_query_id: query.id), class: "px-3 py-1.5 hover:text-zinc-950" %>
        <%= button_to "x", saved_transaction_query_path(query), method: :delete, class: "border-l border-zinc-200 px-2.5 py-1.5 text-zinc-400 hover:text-zinc-950" %>
      </span>
    <% end %>
  </section>
<% end %>

<%= render "transactions_list" %>
