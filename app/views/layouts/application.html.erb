<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Transactions" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Transactions">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="application-name" content="Transactions">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#fafaf6">
    <meta name="msapplication-TileColor" content="#fafaf6">
    <script>
      (() => {
        const lightThemeColor = "#fafaf6"
        const dimThemeColor = "#3b3429"
        const defaultAccentColor = "#0f766e"
        const savedTheme = window.localStorage.getItem("transactions-theme")
        const prefersDim = window.matchMedia("(prefers-color-scheme: dark)").matches
        const theme = savedTheme === "dim" || savedTheme === "dark" || (!savedTheme && prefersDim) ? "dim" : "light"
        const themeColor = theme === "dim" ? dimThemeColor : lightThemeColor
        const accentColor = /^#[0-9a-f]{6}$/i.test(window.localStorage.getItem("transactions-accent-color") || "") ? window.localStorage.getItem("transactions-accent-color") : defaultAccentColor
        const accentForegroundColor = (hexColor) => {
          const value = hexColor.slice(1)
          const channels = [0, 2, 4].map((index) => {
            const channel = parseInt(value.slice(index, index + 2), 16) / 255
            return channel <= 0.03928 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4
          })
          const luminance = channels[0] * 0.2126 + channels[1] * 0.7152 + channels[2] * 0.0722

          return luminance > 0.42 ? "#11140f" : "#fffaf0"
        }

        document.documentElement.classList.toggle("dark", theme === "dim")
        document.documentElement.style.setProperty("--user-accent", accentColor)
        document.documentElement.style.setProperty("--primary", accentColor)
        document.documentElement.style.setProperty("--primary-foreground", accentForegroundColor(accentColor))
        document.documentElement.style.setProperty("--ring", `color-mix(in oklch, ${accentColor} 72%, var(--foreground))`)
        document.documentElement.style.setProperty("--accent", `color-mix(in oklch, ${accentColor} ${theme === "dim" ? "30%" : "16%"}, var(--background))`)
        document.documentElement.style.setProperty("--accent-foreground", `color-mix(in oklch, ${accentColor} ${theme === "dim" ? "38%" : "70%"}, var(--foreground))`)
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", themeColor)
        document.querySelector('meta[name="msapplication-TileColor"]')?.setAttribute("content", themeColor)
      })()
    </script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">

    <%= vite_client_tag %>
    <%= vite_javascript_tag "inertia" %>
    <%= inertia_ssr_head %>
  </head>

  <body class="text-zinc-950 antialiased">
    <%= yield %>
  </body>
</html>
