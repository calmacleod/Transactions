<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Transactions" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Transactions">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="text-zinc-950 antialiased">
    <div class="app-shell">
      <aside class="app-sidebar">
        <div class="app-sidebar-top">
          <%= link_to root_path, class: "app-brand" do %>
            <span class="app-brand-mark"></span>
            <span>Transactions</span>
          <% end %>

          <% if authenticated? %>
            <div class="app-sign-out">
              <%= button_to "Sign out", session_path, method: :delete %>
            </div>
          <% end %>
        </div>

        <% if authenticated? %>
          <nav class="app-nav">
            <%= link_to "Dashboard", root_path %>
            <%= link_to "Transactions", transactions_path %>
            <%= link_to "Insights", insights_path %>
            <%= link_to "Models", models_path %>
          </nav>
        <% end %>
      </aside>

      <main class="app-main">
        <% if notice.present? %>
          <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800"><%= notice %></div>
        <% end %>

        <% if alert.present? %>
          <div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800"><%= alert %></div>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
