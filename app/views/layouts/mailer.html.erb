<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #fafaf6;
        color: #18181b;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }
      .shell {
        max-width: 640px;
        margin: 0 auto;
        padding: 32px 20px;
      }
      .brand {
        margin-bottom: 20px;
      }
      .brand-mark {
        display: inline-block;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: #18181b;
        vertical-align: middle;
      }
      .brand-name {
        display: inline-block;
        margin-left: 10px;
        font-weight: 700;
        vertical-align: middle;
      }
      .card {
        background: #ffffff;
        border: 1px solid #e7e5df;
        border-radius: 8px;
        padding: 28px;
      }
      h1 {
        margin: 0 0 12px;
        font-size: 24px;
        line-height: 1.25;
      }
      p {
        margin: 0 0 16px;
        color: #52525b;
        font-size: 15px;
        line-height: 1.6;
      }
      .button {
        display: inline-block;
        margin: 8px 0 18px;
        padding: 10px 16px;
        border-radius: 8px;
        background: #18181b;
        color: #ffffff !important;
        font-weight: 600;
        text-decoration: none;
      }
      .code {
        display: inline-block;
        margin: 4px 0 18px;
        padding: 10px 14px;
        border: 1px solid #d4d4d8;
        border-radius: 8px;
        color: #18181b;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 20px;
        letter-spacing: 2px;
      }
      .muted {
        color: #71717a;
        font-size: 13px;
      }
    </style>
  </head>

  <body>
    <div class="shell">
      <div class="brand">
        <span class="brand-mark"></span>
        <span class="brand-name">Transactions</span>
      </div>
      <div class="card">
        <%= yield %>
      </div>
    </div>
  </body>
</html>
